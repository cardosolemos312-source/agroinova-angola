                href={imagem.url}
                target="_blank"
                rel="noopener noreferrer"
                className="block"
              >
                <img
                  src={imagem.src}
                  alt={imagem.alt}
                  className="h-[430px] w-full object-cover transition hover:scale-[1.01]"
                />
              </a>

              <div className="p-6">
                <p className="font-semibold leading-7 text-green-950">
