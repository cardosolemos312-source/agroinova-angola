      </div>

      <section className="mx-auto max-w-7xl px-5 py-10 sm:px-8 lg:px-10">
        <div className="grid gap-8 lg:grid-cols-[320px_1fr]">
          <aside className="lg:sticky lg:top-5 lg:self-start">
            <div className="rounded-2xl border border-green-100 bg-white p-5 shadow-sm">
              <h2 className="text-xl font-black text-green-950">
                Conteúdos de sanidade
              </h2>

              <p className="mt-2 text-sm leading-6 text-slate-600">
                Pesquise por tema ou seleccione directamente uma área técnica.
              </p>

              <div className="mt-5">
                <input
                  type="search"
                  value={busca}
                  onChange={(e) => setBusca(e.target.value)}
                  placeholder="Pesquisar sanidade..."
                  className="w-full rounded-xl border border-slate-200 px-4 py-3 text-sm outline-none transition focus:border-green-700 focus:ring-2 focus:ring-green-100"
                />
              </div>

              <div className="mt-5 max-h-[650px] space-y-2 overflow-y-auto pr-1">
                {temasFiltrados.map((tema) => {
                  const activo = temaActivo === tema.id;

                  return (
                    <button
                      key={tema.id}
                      onClick={() => setTemaActivo(tema.id)}
                      className={`w-full rounded-xl px-4 py-3 text-left transition ${
                        activo
                          ? "bg-green-950 text-white"
                          : "bg-slate-50 text-slate-700 hover:bg-green-50 hover:text-green-950"
                      }`}
                    >
                      <div className="font-semibold">{tema.titulo}</div>
                      <div
                        className={`mt-1 text-xs leading-5 ${
                          activo ? "text-green-100" : "text-slate-500"
                        }`}
                      >
                        {tema.resumo}
                      </div>
                    </button>
