function CaixaInfo({
  titulo,
  children,
}: {
  titulo: string;
  children: React.ReactNode;
}) {
  return (
    <div className="rounded-2xl border border-green-100 bg-white p-6 shadow-sm">
      <h3 className="mb-3 text-lg font-bold text-green-950">{titulo}</h3>
      <div className="text-sm leading-7 text-slate-700">{children}</div>
    </div>
  );
}

function TabelaComparativa({
  linhas,
}: {
  linhas: { categoria: string; sinais: string; atenção: string }[];
}) {
  return (
    <div className="overflow-hidden rounded-2xl border border-green-100 bg-white shadow-sm">
      <div className="overflow-x-auto">
        <table className="min-w-full text-left text-sm">
          <thead className="bg-green-950 text-white">
            <tr>
              <th className="px-5 py-4">Situação</th>
              <th className="px-5 py-4">Sinais possíveis</th>
              <th className="px-5 py-4">Conduta sanitária</th>
            </tr>
          </thead>
          <tbody>
            {linhas.map((linha, index) => (
              <tr
                key={linha.categoria}
                className={index % 2 === 0 ? "bg-white" : "bg-green-50/40"}
              >
                <td className="px-5 py-4 align-top font-semibold text-green-950">
                  {linha.categoria}
                </td>
                <td className="px-5 py-4 align-top leading-6 text-slate-700">
                  {linha.sinais}
                </td>
                <td className="px-5 py-4 align-top leading-6 text-slate-700">
                  {linha.atenção}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}

export default function SanidadeSuinaPage() {
  const [busca, setBusca] = useState("");
  const [temaActivo, setTemaActivo] = useState("conceito");
  const [mostrarFontes, setMostrarFontes] = useState(false);
  const [imagemActiva, setImagemActiva] = useState(0);

  const temasFiltrados = useMemo(() => {
    const termo = busca.trim().toLowerCase();

    if (!termo) return temas;

    return temas.filter(
      (tema) =>
        tema.titulo.toLowerCase().includes(termo) ||
        tema.resumo.toLowerCase().includes(termo)
    );
  }, [busca]);

  const imagem = imagens[imagemActiva];

  const conteudo = {
    conceito: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            O que significa sanidade suína?
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Sanidade suína é o conjunto de conhecimentos, medidas preventivas,
            práticas de maneio, vigilância, diagnóstico e intervenção utilizados
            para manter os suínos saudáveis, reduzir a ocorrência de doenças e
            limitar as perdas provocadas por agentes infecciosos, parasitas,
            deficiências de maneio, condições ambientais inadequadas e outros
            factores de risco.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Numa exploração moderna, sanidade não deve ser entendida apenas como
            “tratar animais doentes”. O objectivo principal é diminuir a
            probabilidade de doença, detectar alterações o mais cedo possível e
            impedir que um problema localizado se transforme num problema do
            efectivo. A FAO considera a biossegurança uma componente fundamental
            da prevenção e resposta a ameaças sanitárias nas cadeias pecuárias.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-3">
          <CaixaInfo titulo="Saúde individual">
            Avalia o estado de cada animal: comportamento, apetite, consumo de
            água, temperatura quando indicada, respiração, fezes, pele,
            locomoção, condição corporal e resposta ao ambiente.
          </CaixaInfo>

          <CaixaInfo titulo="Saúde do efectivo">
            Observa padrões. Se vários animais da mesma idade apresentam tosse,
            diarreia, febre, perda de crescimento ou aumento de mortalidade, o
            problema deixa de ser apenas individual.
          </CaixaInfo>

          <CaixaInfo titulo="Saúde da exploração">
            Relaciona animais, pessoas, instalações, água, alimentação,
            transporte, equipamentos, fluxo de produção, resíduos e ambiente.
          </CaixaInfo>
        </div>

        <div className="rounded-2xl bg-green-950 p-7 text-white">
          <h3 className="text-xl font-bold">
            Princípio fundamental para o estudante
          </h3>
          <p className="mt-3 leading-8 text-green-50">
            Um sinal clínico raramente identifica sozinho uma doença. Tosse,
            diarreia, febre, emagrecimento, aborto ou mortalidade podem ter
            diferentes causas. A interpretação deve combinar idade, lote,
            histórico, ambiente, maneio, evolução temporal, sinais clínicos,
            lesões e, quando necessário, exames laboratoriais.
          </p>
        </div>
      </div>
    ),

    vigilancia: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Vigilância clínica diária
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A vigilância é uma das ferramentas mais económicas de um programa
            sanitário. O tratador ou técnico que conhece o comportamento normal
            dos animais consegue perceber alterações antes que elas provoquem
            grandes perdas. A observação deve ser sistemática e registada.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Comportamento",
              sinais:
                "Animal isolado, apático, agressivo, deitado durante períodos anormais ou com menor resposta ao ambiente.",
              atenção:
                "Comparar com o comportamento normal do lote e verificar se o fenómeno é individual ou colectivo.",
            },
            {
              categoria: "Alimentação",
              sinais:
                "Redução do consumo, recusa de alimento, competição anormal ou alterações repentinas.",
              atenção:
                "Verificar ração, comedouro, água, temperatura, doença e mudanças recentes de dieta.",
            },
            {
              categoria: "Respiração",
              sinais:
                "Tosse, espirros, respiração abdominal, dispneia, corrimento nasal ou dificuldade respiratória.",
              atenção:
                "Avaliar ventilação, poeira, gases, densidade, temperatura e possível agente infeccioso.",
            },
            {
              categoria: "Sistema digestivo",
              sinais:
                "Diarreia, fezes muito líquidas, sangue, muco, alteração de cor ou aumento da frequência.",
              atenção:
                "Registar idade e lote; considerar dieta, higiene, água, agentes infecciosos e parasitas.",
            },
            {
              categoria: "Pele",
              sinais:
                "Vermelhidão, lesões, crostas, manchas, prurido, mordeduras ou alterações de coloração.",
              atenção:
                "Investigar ectoparasitas, traumatismos, infecções, condições ambientais e problemas sistémicos.",
            },
            {
              categoria: "Locomoção",
              sinais:
                "Claudicação, dificuldade para levantar, rigidez ou animais que evitam movimentar-se.",
              atenção:
                "Avaliar piso, lesões, articulações, casco, traumatismos e doenças infecciosas.",
            },
            {
              categoria: "Reprodução",
              sinais:
                "Abortos, repetição de cio, redução de nascidos vivos, natimortos ou mumificados.",
              atenção:
                "Avaliar histórico reprodutivo, doenças infecciosas, nutrição, micotoxinas, maneio e ambiente.",
            },
            {
              categoria: "Mortalidade",
              sinais:
                "Aumento inesperado de mortes, mortes agrupadas ou mortalidade acima do padrão histórico.",
              atenção:
                "Tratar como sinal de alerta epidemiológico e comunicar ao responsável veterinário.",
            },
          ]}
        />

        <CaixaInfo titulo="Perguntas que devem acompanhar cada observação">
          Quem adoeceu? Em que idade? Em que lote? Quantos animais estão afectados?
          Quando começaram os sinais? Quantos morreram? Houve mudança de ração,
          água, instalações, pessoal, animais introduzidos ou transporte? Os
          sinais estão a aumentar, diminuir ou permanecer estáveis?
        </CaixaInfo>
      </div>
    ),

    sindromes: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Pensar por síndromes antes de pensar numa doença
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Em medicina veterinária de produção, o primeiro passo é reconhecer
            uma síndrome. Isto evita conclusões precipitadas baseadas apenas num
            sinal. O diagnóstico diferencial deve ser construído com base no
            grupo afectado, idade, velocidade de propagação, sinais associados,
            mortalidade, ambiente e resultados laboratoriais.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Síndrome respiratória",
              sinais:
                "Tosse, espirros, corrimento nasal, dispneia, respiração abdominal e menor crescimento.",
              atenção:
                "Considerar agentes infecciosos, coinfecções, ventilação, poeira, gases, temperatura e densidade.",
            },
            {
              categoria: "Síndrome entérica",
              sinais:
                "Diarreia, desidratação, atraso de crescimento, fezes com muco ou sangue.",
              atenção:
                "Considerar idade, alimentação, água, higiene, bactérias, vírus e parasitas.",
            },
            {
              categoria: "Síndrome febril/sistémica",
              sinais:
                "Febre, apatia, anorexia, fraqueza, alterações cutâneas ou mortalidade.",
              atenção:
                "Doenças sistémicas exigem avaliação veterinária e, em situações suspeitas de doenças notificáveis, resposta oficial.",
            },
            {
              categoria: "Síndrome reprodutiva",
              sinais:
                "Abortos, infertilidade, repetição de cio, natimortos e mumificados.",
              atenção:
                "Investigar doenças infecciosas e também causas nutricionais, ambientais e de maneio.",
            },
            {
              categoria: "Síndrome neurológica",
              sinais:
                "Tremores, incoordenação, convulsões, alterações de postura ou dificuldade de locomoção.",
              atenção:
                "Exige avaliação veterinária rápida porque possui múltiplas causas possíveis.",
            },
            {
              categoria: "Morte súbita",
              sinais:
                "Morte de animais aparentemente normais num intervalo curto.",
              atenção:
                "Não assumir intoxicação ou infecção sem investigação. Isolar a situação e procurar avaliação veterinária.",
            },
          ]}
        />

        <div className="rounded-2xl border border-red-200 bg-red-50 p-6">
          <h3 className="font-bold text-red-950">Regra importante</h3>
          <p className="mt-2 leading-7 text-red-900">
            A presença de sinais compatíveis com uma determinada doença não
            significa que a doença esteja confirmada. Em doenças como a PPA, a
            confirmação depende de diagnóstico laboratorial e da actuação das
            autoridades veterinárias.
          </p>
        </div>
      </div>
    ),

    respiratorias: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Doenças respiratórias dos suínos
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Os problemas respiratórios estão entre os principais desafios
            sanitários da produção suína. A literatura veterinária actual
            destaca que muitas pneumonias são multifactorais: diferentes agentes
            podem actuar em conjunto e factores ambientais podem agravar o
            quadro.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            O complexo respiratório suíno pode envolver vírus, bactérias,
            agentes secundários e factores de maneio. Entre os agentes
            internacionalmente importantes encontram-se Mycoplasma hyopneumoniae,
            Actinobacillus pleuropneumoniae, Pasteurella multocida, influenza,
            PCV2 e PRRSV. A presença ou importância epidemiológica destes agentes
            deve ser determinada localmente e não presumida para Angola.
          </p>
        </div>

        <CaixaInfo titulo="O ambiente também pode causar ou agravar doença">
          Ventilação deficiente, concentração elevada de gases, poeira,
          humidade inadequada, temperaturas extremas, elevada densidade animal
          e mistura de grupos etários podem aumentar o risco de problemas
          respiratórios. Por isso, tratar apenas o agente infeccioso, sem corrigir
          o ambiente, pode produzir resultados insatisfatórios.
        </CaixaInfo>

        <CaixaInfo titulo="Pneumonia enzoótica">
          A pneumonia enzoótica está associada principalmente a Mycoplasma
          hyopneumoniae. A MSD Veterinary Manual descreve tosse seca persistente,
          redução do crescimento e lesões pulmonares como características
          importantes, sendo possível a confirmação por métodos laboratoriais
          como PCR.
        </CaixaInfo>

        <div className="grid gap-5 md:grid-cols-3">
          <CaixaInfo titulo="Observar">
            Frequência da tosse, idade dos animais, número de afectados,
            corrimento nasal, dificuldade respiratória e ganho de peso.
          </CaixaInfo>
          <CaixaInfo titulo="Investigar">
            Ventilação, poeira, gases, densidade, fluxo de animais e histórico
            sanitário.
          </CaixaInfo>
          <CaixaInfo titulo="Confirmar">
            Quando necessário, recorrer a avaliação veterinária, necropsia e
            exames laboratoriais.
          </CaixaInfo>
        </div>
      </div>
    ),

    entericas: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Doenças digestivas e diarreias
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Diarreia é um sinal clínico, não um diagnóstico. A mesma manifestação
            pode resultar de bactérias, vírus, parasitas, alterações alimentares,
            problemas de água, higiene deficiente ou combinação de factores.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A MSD Veterinary Manual apresenta as doenças bacterianas entéricas
            de acordo com a idade dos animais, mostrando a importância de
            interpretar a diarreia em função da fase produtiva.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-2">
          <CaixaInfo titulo="Leitões lactentes">
            Nesta fase, a atenção deve concentrar-se na ingestão adequada de
            colostro, higiene da maternidade, temperatura, qualidade da água,
            estado sanitário da porca e ocorrência de diarreia no lote.
          </CaixaInfo>

          <CaixaInfo titulo="Pós-desmame">
            O desmame altera alimentação, ambiente, microbiota intestinal e
            relações sociais. Por isso, o período pode apresentar maior risco
            de diarreia e redução do desempenho.
          </CaixaInfo>

          <CaixaInfo titulo="Crescimento e engorda">
            Alterações de fezes, consumo e ganho de peso devem ser relacionadas
            com qualidade da alimentação, água, parasitas, higiene e agentes
            infecciosos.
          </CaixaInfo>

          <CaixaInfo titulo="Diarreia com sangue">
            É um sinal de alerta que possui diferentes diagnósticos diferenciais.
            Parasitas como Trichuris suis podem produzir diarreia hemorrágica e
            podem ser confundidos clinicamente com outras doenças entéricas.
          </CaixaInfo>
        </div>

        <div className="rounded-2xl bg-green-50 p-6">
          <h3 className="font-bold text-green-950">
            O que registar numa exploração?
          </h3>
          <p className="mt-3 leading-7 text-slate-700">
            Idade, lote, número de animais afectados, aspecto das fezes,
            duração, mortalidade, consumo de água e ração, mudança recente de
            alimento, origem dos animais, higiene das instalações e tratamentos
            já realizados.
          </p>
        </div>
      </div>
    ),

    ppa: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Peste Suína Africana — PPA
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A peste suína africana é uma doença viral altamente contagiosa dos
            suínos domésticos e selvagens. Segundo a WOAH, a mortalidade pode
            atingir 100%, causando perdas económicas graves e afectando a
            produção e os meios de subsistência.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A PPA não é uma doença humana. No entanto, pessoas, veículos,
            calçado, roupa, equipamentos, produtos suínos contaminados e
            determinadas práticas de alimentação podem participar na disseminação
            do vírus entre populações de suínos.
          </p>
        </div>

        <div className="rounded-2xl bg-red-950 p-7 text-white">
          <h3 className="text-xl font-bold">
            Suspeita de PPA exige resposta sanitária
          </h3>
          <p className="mt-3 leading-8 text-red-50">
            Se houver mortalidade anormal, sinais compatíveis ou suspeita
            epidemiológica, o produtor não deve tentar confirmar a doença apenas
            visualmente. Deve limitar movimentos e contactos de risco e comunicar
            imediatamente aos serviços veterinários competentes para investigação
            e confirmação laboratorial.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-2">
          <CaixaInfo titulo="Principais vias de transmissão">
            Contacto directo entre animais infectados; materiais contaminados;
            roupa e calçado; veículos e equipamentos; produtos suínos
            contaminados; alimentos ou restos contendo produtos de origem suína;
            e, em determinados contextos epidemiológicos, vectores biológicos e
            suínos selvagens.
          </CaixaInfo>

          <CaixaInfo titulo="Prevenção">
            Controlo da entrada de animais, controlo de visitantes, limpeza e
            desinfecção adequadas, controlo de veículos, quarentena, segurança
            da alimentação, controlo de resíduos e vigilância permanente.
          </CaixaInfo>

          <CaixaInfo titulo="Diagnóstico">
            Os sinais clínicos podem levantar suspeita, mas a confirmação requer
            testes laboratoriais. A diferenciação em relação à peste suína
            clássica é especialmente importante.
          </CaixaInfo>

          <CaixaInfo titulo="Não alimentar com restos de carne">
            A WOAH recomenda não alimentar suínos com restos de cozinha ou
            resíduos não tratados que contenham carne ou produtos suínos,
            devido ao risco de introdução do vírus.
          </CaixaInfo>
        </div>

        <div>
          <h3 className="mb-4 text-2xl font-black text-green-950">
            PPA não deve ser confundida com diagnóstico visual
          </h3>

          <TabelaComparativa
            linhas={[
              {
                categoria: "Febre e apatia",
                sinais:
                  "Pode ocorrer em várias doenças infecciosas e sistémicas.",
                atenção:
                  "Não permite confirmar PPA. Avaliar o contexto epidemiológico.",
              },
              {
                categoria: "Hemorragias ou alterações cutâneas",
                sinais:
                  "Podem aparecer em quadros graves, mas não são exclusivas da PPA.",
                atenção:
                  "Necessitam de avaliação clínica e laboratorial.",
              },
              {
                categoria: "Mortalidade elevada",
                sinais:
                  "Pode ser observada em doenças graves de diferentes causas.",
                atenção:
                  "Mortalidade súbita ou crescente deve activar investigação.",
              },
            ]}
          />
        </div>

        <CaixaInfo titulo="Importância para Angola">
          Em Março de 2024, os serviços veterinários do Bengo suspenderam
          temporariamente a venda de carne de porco e derivados por suspeita de
          peste suína em duas fazendas no Dande. A notícia registou mortalidade
          de aproximadamente 100 animais e recolha de amostras para análise.
          Trata-se de um episódio noticiado como suspeita naquele momento e deve
          ser apresentado academicamente como tal, sem transformar a notícia numa
          confirmação laboratorial nacional.
        </CaixaInfo>
      </div>
    ),

    psc: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Peste Suína Clássica
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A peste suína clássica é uma doença viral contagiosa dos suínos
            domésticos e selvagens. É uma doença distinta da peste suína
            africana, embora algumas manifestações clínicas possam ser
            semelhantes.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Por esta razão, perante um quadro compatível com uma doença sistémica
            grave, não é cientificamente adequado concluir “é PPA” apenas pela
            aparência dos animais. A WOAH destaca a necessidade de diagnóstico
            para diferenciar a PPA da peste suína clássica.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-3">
          <CaixaInfo titulo="Transmissão">
            O contacto directo entre animais infectados é uma via importante,
            podendo também existir transmissão associada a carne e produtos
            contaminados.
          </CaixaInfo>

          <CaixaInfo titulo="Prevenção">
            Higiene, biossegurança, controlo de movimentos, vigilância e
            comunicação com os serviços veterinários são fundamentais.
          </CaixaInfo>

          <CaixaInfo titulo="Diagnóstico">
            Deve ser estabelecido por profissionais veterinários com recurso a
            métodos laboratoriais apropriados.
          </CaixaInfo>
        </div>
      </div>
    ),

    parasitas: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Parasitas internos e externos
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            As parasitoses podem provocar perdas silenciosas. Nem sempre existe
            mortalidade elevada; muitas vezes o problema aparece como pior
            conversão alimentar, menor crescimento, anemia, diarreia, lesões
            cutâneas ou maior susceptibilidade a outros factores.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Ascaris suum",
              sinais:
                "Pode prejudicar eficiência alimentar e, em infecções intensas, contribuir para emagrecimento.",
              atenção:
                "A higiene ambiental e o diagnóstico devem orientar o controlo.",
            },
            {
              categoria: "Trichuris suis",
              sinais:
                "Infecções intensas podem provocar inflamação intestinal, diarreia e emagrecimento.",
              atenção:
                "Pode entrar no diagnóstico diferencial de diarreia hemorrágica.",
            },
            {
              categoria: "Strongyloides ransomi",
              sinais:
                "Pode provocar diarreia grave em leitões jovens.",
              atenção:
                "A higiene da maternidade e o acompanhamento dos leitões são fundamentais.",
            },
            {
              categoria: "Ectoparasitas",
              sinais:
                "Prurido, lesões cutâneas, crostas, inquietação e perda de condição.",
              atenção:
                "Avaliar animais, instalações e possibilidade de transmissão entre grupos.",
            },
          ]}
        />

        <CaixaInfo titulo="Não fazer desparasitação às cegas">
          A utilização repetida de antiparasitários sem conhecer o problema pode
          gerar custos, selecção de resistência e falsa sensação de controlo.
          Sempre que possível, o programa deve ser baseado no risco da exploração,
          avaliação clínica, histórico e métodos diagnósticos apropriados.
        </CaixaInfo>
      </div>
    ),

    leitoes: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Sanidade dos leitões
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A fase neonatal apresenta riscos próprios. O leitão nasce com
            reservas limitadas e depende fortemente do ambiente, do colostro, da
            capacidade materna e da gestão da maternidade.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-2">
          <CaixaInfo titulo="Colostro">
            A ingestão adequada de colostro nas primeiras horas é essencial para
            fornecer energia e imunidade passiva. O acompanhamento deve considerar
            o tamanho da ninhada, vitalidade dos leitões e capacidade da porca.
          </CaixaInfo>

          <CaixaInfo titulo="Temperatura">
            Leitões recém-nascidos são particularmente sensíveis ao frio. Uma
            maternidade bem organizada deve oferecer condições que permitam
            conciliar conforto dos leitões e conforto térmico da porca.
          </CaixaInfo>

          <CaixaInfo titulo="Higiene">
            Instalações limpas e secas reduzem a carga ambiental de agentes
            infecciosos e facilitam a observação dos animais.
          </CaixaInfo>

          <CaixaInfo titulo="Diarreia">
            Registar idade de início, número de afectados, aspecto das fezes,
            mortalidade e resposta às medidas implementadas. A causa deve ser
            investigada, não simplesmente presumida.
          </CaixaInfo>

          <CaixaInfo titulo="Umbigo e lesões">
            A observação do umbigo, pele, articulações e capacidade de se
            levantar ajuda a detectar problemas precocemente.
          </CaixaInfo>

          <CaixaInfo titulo="Desmame">
            O desmame representa uma transição importante. Mudanças de alimentação,
            ambiente e grupo podem aumentar o stress e favorecer problemas
            digestivos e de desempenho.
          </CaixaInfo>
        </div>
      </div>
    ),

    reproducao: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Sanidade reprodutiva
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Uma exploração pode apresentar boa taxa de crescimento e ainda assim
            ter perdas económicas significativas por problemas reprodutivos.
            Abortos, repetição de cio, infertilidade, ninhadas pequenas,
            natimortos e mumificados devem ser tratados como informação
            epidemiológica.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Aborto",
              sinais:
                "Perda da gestação antes do parto esperado.",
              atenção:
                "Investigar causas infecciosas e não infecciosas, incluindo ambiente e alimentação.",
            },
            {
              categoria: "Repetição de cio",
              sinais:
                "Fêmea retorna ao cio após cobertura ou inseminação.",
              atenção:
                "Avaliar fertilidade, maneio, condição corporal, detecção de cio e sanidade.",
            },
            {
              categoria: "Natimortos",
              sinais:
                "Leitões mortos ao nascimento.",
              atenção:
                "Registar por porca e por parto e investigar tendência do efectivo.",
            },
            {
              categoria: "Mumificados",
              sinais:
                "Fetos de diferentes graus de desenvolvimento sem viabilidade.",
              atenção:
                "A ocorrência repetida exige investigação veterinária.",
            },
          ]}
        />

        <CaixaInfo titulo="Doenças com impacto reprodutivo">
          Diversos agentes infecciosos podem interferir na reprodução. A MSD
          Veterinary Manual inclui, entre outros, PRRS, parvovírus suíno,
          PCV2, leptospirose, erisipela e outras doenças como possíveis
          factores de impacto reprodutivo. A ocorrência de cada agente deve ser
          determinada por investigação epidemiológica e laboratorial local.
        </CaixaInfo>
      </div>
    ),

    biosseguranca: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Biossegurança: a primeira linha de defesa
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Biossegurança é a aplicação organizada de medidas destinadas a
            diminuir a probabilidade de entrada de agentes patogénicos na
            exploração e a sua disseminação depois de introduzidos.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A literatura científica distingue frequentemente biossegurança
            externa, relacionada com impedir a entrada de agentes, e
            biossegurança interna, relacionada com impedir a sua propagação
            dentro da exploração.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-2">
          <CaixaInfo titulo="Biossegurança externa">
            Compra de animais, origem genética, transporte, visitantes,
            trabalhadores que circulam entre explorações, veículos, equipamentos,
            contacto com outros suínos, alimentos, água, resíduos e possíveis
            contactos com animais selvagens.
          </CaixaInfo>

          <CaixaInfo titulo="Biossegurança interna">
            Separação por idade, fluxo de pessoas, fluxo de equipamentos,
            limpeza, desinfecção, gestão de cadáveres, controlo de doenças entre
            lotes e organização dos movimentos dentro da exploração.
          </CaixaInfo>
        </div>

        <div>
          <h3 className="mb-4 text-2xl font-black text-green-950">
            Limpeza não é o mesmo que desinfecção
          </h3>

          <p className="leading-8 text-slate-700">
            A limpeza procura remover matéria orgânica, fezes, restos de
            alimentação e sujidade. A desinfecção procura reduzir ou eliminar
            microrganismos após a superfície estar adequadamente preparada. Se
            houver matéria orgânica em excesso, a eficácia de muitos
            desinfectantes pode ser reduzida.
          </p>
        </div>

        <div className="rounded-2xl bg-green-50 p-7">
          <h3 className="font-bold text-green-950">
            Biossegurança deve ser adaptada ao sistema
          </h3>
          <p className="mt-3 leading-8 text-slate-700">
            Uma pequena exploração familiar e uma unidade intensiva possuem
            riscos diferentes. O objectivo não é copiar um protocolo estrangeiro,
            mas identificar as vias reais de entrada e transmissão existentes na
            exploração angolana e estabelecer medidas que possam ser mantidas
            todos os dias.
          </p>
        </div>
      </div>
    ),

    quarentena: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Quarentena e introdução de novos animais
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A introdução de animais é uma das decisões sanitárias mais
            importantes de uma exploração. Um animal aparentemente saudável pode
            transportar agentes que ainda não produziram sinais clínicos.
          </p>
        </div>

        <div className="grid gap-4 md:grid-cols-5">
          {[
            ["01", "Origem", "Conhecer fornecedor e histórico sanitário."],
            ["02", "Separação", "Manter os recém-chegados separados."],
            ["03", "Observação", "Monitorizar sinais e consumo."],
            ["04", "Avaliação", "Recorrer a avaliação veterinária e testes quando indicados."],
            ["05", "Integração", "Introduzir somente após decisão sanitária."],
          ].map(([numero, titulo, texto]) => (
            <div
              key={numero}
              className="rounded-2xl border border-green-100 bg-white p-5 shadow-sm"
            >
              <div className="text-sm font-black text-green-700">{numero}</div>
              <h3 className="mt-2 font-bold text-green-950">{titulo}</h3>
              <p className="mt-2 text-sm leading-6 text-slate-600">{texto}</p>
            </div>
          ))}
        </div>

        <CaixaInfo titulo="A quarentena não é apenas esperar">
          A separação deve permitir observação clínica, avaliação da origem,
          histórico, exames quando indicados e adaptação sanitária adequada. O
          período e os testes necessários devem ser definidos pelo veterinário
          responsável de acordo com os riscos da exploração e das doenças de
          interesse.
        </CaixaInfo>
      </div>
    ),

    agua: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Água como factor sanitário
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A água é simultaneamente nutriente, recurso essencial à termorregulação
            e potencial veículo de agentes biológicos ou contaminantes. Uma
            exploração sanitariamente organizada deve conhecer a origem da água,
            proteger o armazenamento e verificar regularmente o sistema de
            distribuição.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-3">
          <CaixaInfo titulo="Fonte">
            Poço, rede, nascente ou outra origem devem ser conhecidos e avaliados
            segundo o risco de contaminação.
          </CaixaInfo>

          <CaixaInfo titulo="Armazenamento">
            Reservatórios precisam de manutenção, protecção contra entrada de
            sujidade e controlo adequado.
          </CaixaInfo>

          <CaixaInfo titulo="Distribuição">
            Bebedouros e linhas precisam de inspecção e limpeza. O animal deve
            ter acesso suficiente à água.
          </CaixaInfo>
        </div>

        <CaixaInfo titulo="Sinais indirectos de problemas">
          Redução do consumo, animais que procuram água de forma anormal,
          linhas obstruídas, bebedouros com fuga, biofilme, sujidade ou diferenças
          de acesso entre baias podem indicar problemas que afectam saúde e
          desempenho.
        </CaixaInfo>
      </div>
    ),

    alimentacao: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Alimentação e saúde do efectivo
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A alimentação influencia crescimento, imunidade, microbiota
            intestinal e resistência do animal aos desafios ambientais. Problemas
            de qualidade, armazenamento ou mudanças bruscas podem produzir
            alterações sanitárias.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Armazenamento",
              sinais:
                "Humidade, bolores, ração empedrada, insectos ou alterações de cheiro.",
              atenção:
                "Proteger a ração contra água, pragas e deterioração.",
            },
            {
              categoria: "Mudança de dieta",
              sinais:
                "Alterações de consumo ou fezes após mudança de alimentação.",
              atenção:
                "Mudanças devem ser tecnicamente planeadas e acompanhadas.",
            },
            {
              categoria: "Micotoxinas",
              sinais:
                "Podem produzir efeitos variáveis sobre consumo, crescimento e saúde.",
              atenção:
                "A avaliação deve considerar histórico da matéria-prima e condições de armazenamento.",
            },
            {
              categoria: "Competição",
              sinais:
                "Animais menores ou dominados podem ter acesso insuficiente.",
              atenção:
                "Avaliar espaço de comedouro, distribuição e comportamento do lote.",
            },
          ]}
        />
      </div>
    ),

    antimicrobianos: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Antimicrobianos e resistência
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A resistência antimicrobiana é uma questão sanitária de importância
            crescente. O uso inadequado ou excessivo de antimicrobianos pode
            favorecer a selecção de microrganismos resistentes.
          </p>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A literatura científica sobre produção suína reforça a necessidade
            de combinar prevenção, biossegurança, boas práticas de maneio,
            diagnóstico e uso responsável dos medicamentos.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-2">
          <CaixaInfo titulo="O que evitar">
            Não utilizar antibióticos para tratar doenças virais; não copiar
            tratamentos de outra exploração; não interromper ou prolongar
            tratamentos arbitrariamente; não utilizar medicamentos sem orientação
            veterinária.
          </CaixaInfo>

          <CaixaInfo titulo="O que fazer">
            Investigar a causa, melhorar prevenção, seguir prescrição veterinária,
            utilizar produtos autorizados, respeitar períodos de retirada e
            manter registos.
          </CaixaInfo>
        </div>

        <div className="rounded-2xl border border-amber-200 bg-amber-50 p-6">
          <h3 className="font-bold text-amber-950">
            Informação importante para estudantes
          </h3>
          <p className="mt-3 leading-7 text-amber-900">
            Esta página não apresenta doses de medicamentos. A dose, via,
            duração, indicação e período de retirada dependem do diagnóstico,
            animal, produto autorizado, legislação e prescrição veterinária.
          </p>
        </div>
      </div>
    ),

    vacinas: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Vacinação como componente do programa sanitário
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            A vacinação deve ser integrada num programa sanitário baseado no
            risco. Não existe um calendário universal que possa simplesmente ser
            copiado para todas as explorações, regiões e sistemas produtivos.
          </p>
        </div>

        <div className="grid gap-5 md:grid-cols-3">
          <CaixaInfo titulo="Risco">
            Quais doenças são relevantes para a exploração, região, sistema de
            produção e movimentação de animais?
          </CaixaInfo>

          <CaixaInfo titulo="População">
            Que categorias serão vacinadas? Porcas, marrãs, leitões, reprodutores
            ou animais de crescimento podem ter necessidades diferentes.
          </CaixaInfo>

          <CaixaInfo titulo="Avaliação">
            O programa deve ser acompanhado por indicadores sanitários e
            avaliação veterinária, e não apenas pela aplicação da vacina.
          </CaixaInfo>
        </div>

        <CaixaInfo titulo="Importante sobre a PPA">
          A existência de investigação e orientações internacionais sobre vacinas
          contra PPA não significa que exista uma vacina disponível ou autorizada
          para utilização rotineira em todas as explorações de Angola. A estratégia
          deve seguir as autoridades veterinárias competentes e as normas
          aplicáveis.
        </CaixaInfo>
      </div>
    ),

    diagnostico: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Diagnóstico: da observação ao laboratório
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Um diagnóstico de qualidade começa antes do laboratório. O veterinário
            precisa de saber o histórico do lote, idade, sinais, evolução,
            mortalidade, tratamentos anteriores, alterações de alimentação,
            origem dos animais e outras informações epidemiológicas.
          </p>
        </div>

        <div className="grid gap-4 md:grid-cols-4">
          {[
            ["1", "Histórico", "O que mudou na exploração?"],
            ["2", "Clínica", "Que sinais estão presentes?"],
            ["3", "Patologia", "Que lesões são observadas?"],
            ["4", "Laboratório", "Qual agente ou alteração foi demonstrado?"],
          ].map(([n, t, d]) => (
            <div
              key={n}
              className="rounded-2xl border border-green-100 bg-white p-6 shadow-sm"
            >
              <div className="text-3xl font-black text-green-700">{n}</div>
              <h3 className="mt-3 font-bold text-green-950">{t}</h3>
              <p className="mt-2 text-sm leading-6 text-slate-600">{d}</p>
            </div>
          ))}
        </div>

        <CaixaInfo titulo="Amostras">
          A recolha deve ser feita segundo orientação veterinária e laboratorial,
          utilizando procedimentos que preservem a qualidade da amostra e a
          segurança das pessoas. O tipo de amostra depende da suspeita: sangue,
          fezes, zaragatoas, tecidos ou outros materiais podem ser indicados em
          situações diferentes.
        </CaixaInfo>

        <CaixaInfo titulo="Necropsia">
          A necropsia pode fornecer informação valiosa sobre órgãos e lesões,
          mas deve ser realizada com segurança e por pessoal competente,
          especialmente quando existe suspeita de doença infecciosa de alta
          consequência.
        </CaixaInfo>
      </div>
    ),

    indicadores: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Indicadores sanitários da exploração
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            O que não é medido dificilmente pode ser gerido. Os indicadores
            permitem transformar acontecimentos dispersos em informação para
            tomada de decisão.
          </p>
        </div>

        <TabelaComparativa
          linhas={[
            {
              categoria: "Mortalidade",
              sinais:
                "Número ou proporção de animais mortos num período definido.",
              atenção:
                "Comparar por idade, lote e período para identificar alterações.",
            },
            {
              categoria: "Morbilidade",
              sinais:
                "Proporção de animais que apresentam doença ou sinais num grupo.",
              atenção:
                "Ajuda a medir a extensão do problema.",
            },
            {
              categoria: "Letalidade",
              sinais:
                "Proporção dos animais doentes que morrem.",
              atenção:
                "Pode ajudar a caracterizar a gravidade de um episódio.",
            },
            {
              categoria: "Tratamentos",
              sinais:
                "Número de tratamentos e grupos tratados.",
              atenção:
                "Pode revelar doenças recorrentes ou falhas preventivas.",
            },
            {
              categoria: "Perdas reprodutivas",
              sinais:
                "Abortos, repetição de cio, natimortos e mumificados.",
              atenção:
                "Devem ser acompanhados por porca e por período.",
            },
            {
              categoria: "Crescimento",
              sinais:
                "Ganho de peso inferior ao esperado.",
              atenção:
                "Pode estar relacionado com doença subclínica, nutrição ou ambiente.",
            },
          ]}
        />

        <div className="rounded-2xl bg-green-950 p-7 text-white">
          <h3 className="text-xl font-bold">
            Saúde não é apenas ausência de mortalidade
          </h3>
          <p className="mt-3 leading-8 text-green-50">
            Doenças subclínicas podem reduzir crescimento, eficiência alimentar,
            reprodução e qualidade da produção sem provocar grande número de
            mortes. Por isso, um bom sistema sanitário deve acompanhar também
            desempenho e produtividade.
          </p>
        </div>
      </div>
    ),

    registos: (
      <div className="space-y-8">
        <div>
          <h2 className="text-3xl font-black text-green-950">
            Registos sanitários
          </h2>
          <p className="mt-4 text-base leading-8 text-slate-700">
            Os registos transformam a exploração numa fonte de dados. Para
            estudantes e investigadores, constituem também uma base importante
            para estudos epidemiológicos e avaliação de intervenções.
          </p>
        </div>

        <div className="grid gap-4 md:grid-cols-3">
          {[
            "Data da ocorrência",
            "Identificação do lote",
            "Idade dos animais",
            "Número de animais afectados",
            "Número de mortos",
            "Sinais clínicos",
            "Tratamentos realizados",
            "Vacinações",
            "Origem dos animais",
            "Mudanças de alimentação",
            "Mudanças de instalações",
            "Resultados laboratoriais",
          ].map((item) => (
            <div
              key={item}
              className="rounded-xl border border-green-100 bg-white p-4 text-sm font-medium text-green-950 shadow-sm"
            >
              {item}
            </div>
          ))}
        </div>

        <CaixaInfo titulo="Para investigação científica">
          Um registo consistente permite estudar factores associados à doença,
          comparar lotes, calcular indicadores, acompanhar intervenções,
          identificar padrões sazonais e construir bases de dados para
          investigação veterinária e zootécnica.
        </CaixaInfo>
      </div>
    ),
  };

  const conteudoActual =
    conteudo[temaActivo as keyof typeof conteudo] ?? conteudo.conceito;

  return (
    <main className="min-h-screen bg-slate-50 text-slate-900">
      <section className="relative min-h-[620px] overflow-hidden">
