"use client";

import Link from "next/link";

const imagens = {
  hero: "https://quintadopinhao.com/fotos/maternidade.webp",
  leitões: "https://quintadopinhao.com/fotos/leitoes-creche.jpg",
  engorda: "https://quintadopinhao.com/fotos/engorda.webp",
  cuidado: "https://www.porcosabayomi.com/assets/img/porco-cuidado.webp",
  biosseguranca:
    "https://www.porcosabayomi.com/assets/img/porco-biosseguranca.webp",
};

function SectionTitle({
  number,
  title,
  description,
}: {
  number: string;
  title: string;
  description?: string;
}) {
  return (
    <div className="mb-8">
      <div className="mb-3 flex items-center gap-3">
        <span className="text-sm font-bold tracking-[0.18em] text-green-700">
          {number}
        </span>
        <div className="h-px flex-1 bg-green-100" />
      </div>

      <h2 className="text-3xl font-bold tracking-tight text-slate-900 md:text-4xl">
        {title}
      </h2>

      {description && (
        <p className="mt-3 max-w-4xl text-base leading-7 text-slate-600">
          {description}
        </p>
      )}
    </div>
  );
}

function InfoCard({
  title,
  children,
  className = "",
}: {
  title: string;
  children: React.ReactNode;
  className?: string;
}) {
  return (
    <article
      className={`rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md ${className}`}
    >
      <h3 className="mb-3 text-lg font-bold text-slate-900">{title}</h3>
      <div className="text-justify text-[15px] leading-7 text-slate-600">
        {children}
      </div>
    </article>
  );
}

function ImageCard({
  src,
  title,
  caption,
  href,
}: {
  src: string;
  title: string;
  caption: string;
  href: string;
}) {
  return (
    <figure className="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <a
        href={href}
        target="_blank"
        rel="noreferrer"
        className="group block"
      >
        <div className="relative h-64 overflow-hidden bg-slate-100">
          <img
            src={src}
            alt={title}
            className="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          />
          <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-5">
            <p className="text-sm font-semibold text-white">{title}</p>
          </div>
        </div>
      </a>

      <figcaption className="p-4 text-sm leading-6 text-slate-500">
        {caption}
      </figcaption>
    </figure>
  );
}

export default function AguaSuinosPage() {
  return (
    <main className="min-h-screen bg-[#f5f8f5] text-slate-900">
      {/* HERO */}
      <section className="relative overflow-hidden bg-slate-950">
        <div className="absolute inset-0">
          <img
            src={imagens.hero}
            alt="Porca com leitões numa exploração suinícola em Angola"
            className="h-full w-full object-cover opacity-45"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/80 to-slate-950/30" />
        </div>

        <div className="relative mx-auto max-w-7xl px-5 py-24 md:px-8 md:py-32">
          <div className="max-w-4xl">
            <p className="mb-5 text-sm font-bold uppercase tracking-[0.25em] text-green-300">
              AGROINOVA ANGOLA • PECUÁRIA • SUÍNOS
            </p>

            <h1 className="max-w-4xl text-4xl font-black tracking-tight text-white md:text-6xl">
              Água e qualidade sanitária dos suínos
            </h1>

            <p className="mt-6 max-w-3xl text-lg leading-8 text-slate-200 md:text-xl">
              A água não é apenas um recurso utilizado para matar a sede dos
              animais. É um nutriente essencial, participa na termorregulação,
              digestão, transporte de nutrientes, eliminação de resíduos,
              equilíbrio eletrolítico e produção de leite. Numa exploração
              suinícola, a qualidade da água deve ser tratada como parte da
              alimentação, da produtividade e da biossegurança.
            </p>

            <div className="mt-8 flex flex-wrap gap-3">
              <span className="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur">
                Nutrição
              </span>
              <span className="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur">
                Sanidade
              </span>
              <span className="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur">
                Biossegurança
              </span>
              <span className="rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm text-white backdrop-blur">
                Gestão da exploração
              </span>
            </div>
          </div>
        </div>
      </section>

      {/* BREADCRUMB */}
      <div className="border-b border-slate-200 bg-white">
        <div className="mx-auto max-w-7xl px-5 py-4 md:px-8">
          <div className="flex flex-wrap items-center gap-2 text-sm text-slate-500">
            <Link href="/pecuaria" className="hover:text-green-700">
              Pecuária
            </Link>
            <span>/</span>
            <Link
              href="/pecuaria/suinos/orientacoes"
              className="hover:text-green-700"
            >
              Suínos
            </Link>
            <span>/</span>
            <span className="font-medium text-slate-900">Água</span>
          </div>
        </div>
      </div>

      {/* INTRODUÇÃO */}
      <section className="mx-auto max-w-7xl px-5 py-14 md:px-8">
        <div className="grid gap-8 lg:grid-cols-[1.35fr_0.65fr]">
          <div className="rounded-3xl border border-slate-200 bg-white p-7 shadow-sm md:p-10">
            <SectionTitle
              number="01"
              title="Por que a água merece atenção especial?"
            />

            <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
              <p>
                Em muitas explorações pecuárias, a água recebe menos atenção do
                que a ração, a genética ou as instalações. No entanto, um
                suíno pode reduzir rapidamente o consumo de alimento quando não
                encontra água em quantidade suficiente, quando o bebedouro
                apresenta fluxo inadequado ou quando a água possui características
                que reduzem a sua palatabilidade.
              </p>

              <p>
                A água participa de praticamente todos os processos fisiológicos
                importantes. Ela ajuda a manter a temperatura corporal,
                participa das reações metabólicas, transporta nutrientes,
                facilita a digestão, permite a eliminação de resíduos através
                da urina e das fezes e contribui para o equilíbrio dos
                eletrólitos no organismo.
              </p>

              <p>
                Em porcas lactantes, a questão torna-se ainda mais importante.
                A produção de leite aumenta significativamente a necessidade de
                água. Uma restrição hídrica pode comprometer o consumo de ração,
                a produção de leite e, consequentemente, o desempenho dos
                leitões.
              </p>

              <p>
                Por isso, numa exploração moderna, não basta perguntar
                simplesmente se existe água. É necessário perguntar:{" "}
                <strong>
                  de onde vem a água, qual é a sua qualidade, quanto chega ao
                  animal, com que velocidade chega e se permanece disponível
                  durante todo o dia?
                </strong>
              </p>
            </div>
          </div>

          <aside className="rounded-3xl bg-green-900 p-7 text-white shadow-lg md:p-8">
            <p className="text-sm font-bold uppercase tracking-[0.2em] text-green-300">
              Ideia central
            </p>

            <h2 className="mt-4 text-3xl font-bold">
              Água disponível não significa necessariamente água adequada.
            </h2>

            <p className="mt-5 text-justify leading-7 text-green-50">
              Um reservatório cheio não garante que todos os animais estejam
              hidratados. O problema pode estar no bebedouro, na pressão, no
              fluxo, na altura, na tubagem, no biofilme, na contaminação ou na
              própria qualidade da fonte.
            </p>

            <div className="mt-8 border-t border-white/20 pt-6">
              <p className="text-sm font-semibold text-green-200">
                Para o produtor
              </p>
              <p className="mt-2 text-sm leading-6 text-green-50">
                A água deve ser observada como um indicador diário da saúde e
                do funcionamento da exploração.
              </p>
            </div>
          </aside>
        </div>
      </section>

      {/* FUNÇÕES */}
      <section className="bg-white py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="02"
            title="As principais funções da água no organismo"
            description="A água está envolvida em várias funções fisiológicas. Quando a disponibilidade diminui, o impacto pode aparecer primeiro no comportamento e no consumo de alimento, mas também pode comprometer desempenho e saúde."
          />

          <div className="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <InfoCard title="Termorregulação">
              <p>
                O suíno depende da água para manter o equilíbrio térmico. Em
                condições de calor, o consumo de água tende a aumentar. A
                hidratação adequada ajuda o organismo a lidar com o aumento da
                carga térmica, embora não substitua ventilação, sombra,
                densidade adequada e outras medidas de controlo ambiental.
              </p>
            </InfoCard>

            <InfoCard title="Digestão e metabolismo">
              <p>
                A água participa na digestão e no aproveitamento dos nutrientes.
                O organismo necessita de água para transportar substâncias,
                permitir reações metabólicas e manter o funcionamento normal
                do trato gastrointestinal.
              </p>
            </InfoCard>

            <InfoCard title="Transporte de nutrientes">
              <p>
                O sangue e outros fluidos corporais dependem da água para o
                transporte de nutrientes, hormonas, eletrólitos e produtos do
                metabolismo. Uma hidratação inadequada compromete o equilíbrio
                interno do animal.
              </p>
            </InfoCard>

            <InfoCard title="Eliminação de resíduos">
              <p>
                A água é indispensável para a formação e eliminação da urina e
                participa na manutenção do equilíbrio dos resíduos produzidos
                pelo metabolismo.
              </p>
            </InfoCard>

            <InfoCard title="Equilíbrio eletrolítico">
              <p>
                Minerais dissolvidos e eletrólitos precisam permanecer dentro
                de determinados equilíbrios fisiológicos. Água excessivamente
                mineralizada ou contaminada pode representar um problema,
                dependendo da composição e da quantidade consumida.
              </p>
            </InfoCard>

            <InfoCard title="Produção de leite">
              <p>
                Nas porcas lactantes, a água possui importância especial porque
                a produção de leite aumenta as necessidades hídricas. Uma
                restrição pode reduzir a produção de leite e prejudicar o
                crescimento e a sobrevivência dos leitões.
              </p>
            </InfoCard>
          </div>
        </div>
      </section>

      {/* NECESSIDADES */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <SectionTitle
          number="03"
          title="Necessidades de água ao longo da produção"
          description="As necessidades variam com idade, peso, temperatura, alimentação, estado fisiológico e saúde. Os valores abaixo são referências técnicas e não devem ser transformados automaticamente num calendário rígido para todas as explorações."
        />

        <div className="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
          <div className="overflow-x-auto">
            <table className="w-full min-w-[760px] border-collapse text-left">
              <thead className="bg-green-900 text-white">
                <tr>
                  <th className="px-5 py-4 text-sm font-bold">
                    Categoria
                  </th>
                  <th className="px-5 py-4 text-sm font-bold">
                    Referência de consumo
                  </th>
                  <th className="px-5 py-4 text-sm font-bold">
                    Fluxo de referência
                  </th>
                  <th className="px-5 py-4 text-sm font-bold">
                    Observação
                  </th>
                </tr>
              </thead>

              <tbody className="divide-y divide-slate-200">
                <tr>
                  <td className="px-5 py-4 font-semibold">
                    Recém-desmamados
                  </td>
                  <td className="px-5 py-4">1,0–1,5 L/dia</td>
                  <td className="px-5 py-4">≈ 0,3 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    Necessidade de acesso fácil e aprendizagem do uso do
                    bebedouro.
                  </td>
                </tr>

                <tr>
                  <td className="px-5 py-4 font-semibold">Até 20 kg</td>
                  <td className="px-5 py-4">1,5–2,0 L/dia</td>
                  <td className="px-5 py-4">≈ 0,5–1,0 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    Monitorizar crescimento e acesso.
                  </td>
                </tr>

                <tr>
                  <td className="px-5 py-4 font-semibold">20–40 kg</td>
                  <td className="px-5 py-4">2,0–5,0 L/dia</td>
                  <td className="px-5 py-4">≈ 1,0–1,5 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    O consumo aumenta com peso e ambiente.
                  </td>
                </tr>

                <tr>
                  <td className="px-5 py-4 font-semibold">Engorda</td>
                  <td className="px-5 py-4">≈ 5–6 L/dia</td>
                  <td className="px-5 py-4">≈ 1,0–1,5 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    Calor e alimentação podem elevar a necessidade.
                  </td>
                </tr>

                <tr>
                  <td className="px-5 py-4 font-semibold">
                    Porca gestante
                  </td>
                  <td className="px-5 py-4">≈ 5–8 L/dia</td>
                  <td className="px-5 py-4">≈ 2 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    Garantir acesso contínuo.
                  </td>
                </tr>

                <tr className="bg-green-50">
                  <td className="px-5 py-4 font-bold text-green-900">
                    Porca lactante
                  </td>
                  <td className="px-5 py-4 font-bold text-green-900">
                    ≈ 15–30 L/dia
                  </td>
                  <td className="px-5 py-4 font-bold text-green-900">
                    ≈ 2 L/min
                  </td>
                  <td className="px-5 py-4 text-slate-700">
                    Categoria de elevada exigência hídrica.
                  </td>
                </tr>

                <tr>
                  <td className="px-5 py-4 font-semibold">Varrão</td>
                  <td className="px-5 py-4">≈ 5–8 L/dia</td>
                  <td className="px-5 py-4">≈ 2 L/min</td>
                  <td className="px-5 py-4 text-slate-600">
                    Ajustar ao ambiente e atividade.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>

          <div className="border-t border-slate-200 bg-slate-50 p-5 text-sm leading-6 text-slate-600">
            <strong>Nota técnica:</strong> estes valores são referências
            publicadas em orientações veterinárias e de bem-estar. O consumo
            real pode mudar significativamente com temperatura, dieta,
            composição da água, estado fisiológico, doença e sistema de
            produção.
          </div>
        </div>
      </section>

      {/* IMAGENS */}
      <section className="bg-slate-900 py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <div className="mb-10 max-w-3xl">
            <p className="text-sm font-bold uppercase tracking-[0.2em] text-green-300">
              Realidade produtiva
            </p>

            <h2 className="mt-3 text-3xl font-bold text-white md:text-4xl">
              A água deve ser analisada dentro do sistema de produção
            </h2>

            <p className="mt-4 text-justify leading-7 text-slate-300">
              A qualidade da água não pode ser separada das instalações, do
              maneio, da higiene, da alimentação e do estado sanitário dos
              animais. As imagens abaixo apresentam exemplos reais publicados
              por explorações suinícolas que operam em Angola.
            </p>
          </div>

          <div className="grid gap-6 md:grid-cols-3">
            <ImageCard
              src={imagens.leitões}
              title="Leitões na creche"
              caption="Imagem publicada pela Quinta do Pinhão, exploração suinícola localizada em Quimuala, Ambriz, Bengo."
              href="https://quintadopinhao.com/"
            />

            <ImageCard
              src={imagens.engorda}
              title="Animais em fase de engorda"
              caption="Exemplo de produção suinícola publicado pela Quinta do Pinhão, em Angola."
              href="https://quintadopinhao.com/"
            />

            <ImageCard
              src={imagens.cuidado}
              title="Acompanhamento dos animais"
              caption="Imagem publicada pela Porcos Abayomi, exploração de produção suína em Angola."
              href="https://www.porcosabayomi.com/"
            />
          </div>
        </div>
      </section>

      {/* ÁGUA E ALIMENTAÇÃO */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <div className="grid gap-8 lg:grid-cols-2">
          <div className="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200 md:p-10">
            <SectionTitle
              number="04"
              title="Água e alimentação"
              description="O consumo de água está intimamente ligado ao consumo de alimento."
            />

            <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
              <p>
                Em suínos em crescimento, referências veterinárias indicam uma
                relação aproximada de 2 a 3 kg de água para cada kg de matéria
                seca ingerida. Esta relação é apenas uma referência porque
                temperatura, composição da dieta, peso corporal e estado de
                saúde podem modificar o consumo.
              </p>

              <p>
                Quando o animal não consegue beber adequadamente, o problema
                pode aparecer como redução do consumo de ração. Isso significa
                que uma falha aparentemente pequena no sistema de água pode
                acabar refletindo no ganho de peso e na eficiência produtiva.
              </p>

              <p>
                É importante também compreender que a presença de água numa
                ração húmida ou num sistema wet-dry não elimina necessariamente
                a necessidade de uma fonte independente de água potável. Os
                animais devem ter acesso adequado à água de bebida.
              </p>
            </div>
          </div>

          <div className="rounded-3xl border border-green-200 bg-green-50 p-8 md:p-10">
            <h3 className="text-2xl font-bold text-green-950">
              Uma pergunta simples para o produtor
            </h3>

            <p className="mt-5 text-justify text-[16px] leading-8 text-green-950/75">
              Se a ração está disponível, mas os animais diminuíram o consumo,
              será que a primeira verificação deve ser a ração? Nem sempre.
              Antes de alterar a formulação, é importante verificar se os
              animais estão realmente a conseguir beber água.
            </p>

            <div className="mt-7 rounded-2xl bg-white p-6 shadow-sm">
              <p className="text-sm font-bold uppercase tracking-wider text-green-700">
                Verificar
              </p>

              <ul className="mt-4 space-y-3 text-sm leading-6 text-slate-600">
                <li>• Existe água no sistema?</li>
                <li>• O bebedouro funciona?</li>
                <li>• O fluxo é suficiente?</li>
                <li>• A altura está adequada?</li>
                <li>• A água tem cheiro ou cor anormal?</li>
                <li>• Existe vazamento ou obstrução?</li>
                <li>• Houve alteração recente na fonte?</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* ANGOLA */}
      <section className="bg-green-950 py-16 text-white">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="05"
            title="Água na realidade das explorações angolanas"
            description="As recomendações internacionais precisam ser interpretadas à luz das condições reais de produção encontradas em Angola."
          />

          <div className="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
            <div className="overflow-hidden rounded-3xl">
              <img
                src={imagens.biosseguranca}
                alt="Biossegurança em exploração suinícola em Angola"
                className="h-full min-h-[420px] w-full object-cover"
              />
            </div>

            <div className="space-y-6">
              <div className="text-justify text-[16px] leading-8 text-green-50">
                <p>
                  Angola possui sistemas de produção muito diferentes entre
                  si. Existem pequenas explorações familiares, produtores
                  comerciais de pequena e média escala e unidades com sistemas
                  mais intensivos e estruturados. Consequentemente, as fontes
                  de água também variam.
                </p>
              </div>

              <div className="grid gap-4 md:grid-cols-2">
                <InfoCard title="Furos">
                  <p>
                    Podem constituir uma fonte importante em explorações
                    afastadas das redes públicas. Contudo, a água subterrânea
                    não deve ser considerada automaticamente segura. É
                    necessário avaliar a composição físico-química e
                    microbiológica.
                  </p>
                </InfoCard>

                <InfoCard title="Água canalizada">
                  <p>
                    Quando disponível, pode facilitar o controlo da origem, mas
                    a qualidade no ponto de consumo também depende de
                    reservatórios, tubagens e manutenção.
                  </p>
                </InfoCard>

                <InfoCard title="Reservatórios">
                  <p>
                    São importantes para garantir continuidade, especialmente
                    quando existem falhas de fornecimento ou dependência de
                    bombas. Devem permanecer protegidos contra sujidade,
                    animais e entrada de matéria orgânica.
                  </p>
                </InfoCard>

                <InfoCard title="Águas superficiais">
                  <p>
                    Rios, lagoas e outras fontes superficiais podem apresentar
                    maior risco de contaminação microbiológica e devem ser
                    tratadas com especial cautela.
                  </p>
                </InfoCard>
              </div>
            </div>
          </div>

          <div className="mt-10 rounded-3xl border border-white/10 bg-white/10 p-7 backdrop-blur md:p-9">
            <h3 className="text-2xl font-bold">
              Exemplos documentados em Angola
            </h3>

            <p className="mt-4 max-w-5xl text-justify leading-8 text-green-50/90">
              A Quinta do Pinhão, localizada em Quimuala, Ambriz, na província
              do Bengo, apresenta uma estrutura que integra reprodução,
              maternidade, creche e engorda, com acompanhamento veterinário.
              A Porcos Abayomi, também no Bengo, apresenta produção intensiva,
              biossegurança e acompanhamento da produção. Estes exemplos
              demonstram que já existem em Angola sistemas que exigem uma
              abordagem técnica integrada de alimentação, instalações,
              sanidade, água e gestão.
            </p>

            <p className="mt-4 text-sm leading-6 text-green-200">
              Estes casos são exemplos documentados de explorações específicas
              e não devem ser interpretados como representação de todas as
              explorações suinícolas do país.
            </p>
          </div>
        </div>
      </section>

      {/* QUALIDADE */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <SectionTitle
          number="06"
          title="Como avaliar a qualidade da água"
          description="A avaliação deve combinar observação, manutenção do sistema e análise laboratorial."
        />

        <div className="grid gap-6 md:grid-cols-3">
          <InfoCard title="Qualidade física">
            <p>
              Observar turbidez, cor, cheiro, presença de partículas e
              sedimentos. Alterações repentinas podem indicar problemas na
              fonte, reservatório ou tubagem.
            </p>
          </InfoCard>

          <InfoCard title="Qualidade microbiológica">
            <p>
              A presença de microrganismos indicadores pode sinalizar
              contaminação. A avaliação deve ser feita por laboratório
              competente e interpretada juntamente com a origem da água e o
              sistema de produção.
            </p>
          </InfoCard>

          <InfoCard title="Qualidade química">
            <p>
              Parâmetros como pH, sólidos dissolvidos totais, dureza, nitratos,
              sulfatos, ferro e outros minerais podem ser relevantes. A
              composição deve ser conhecida antes de decidir qualquer
              tratamento.
            </p>
          </InfoCard>
        </div>

        <div className="mt-8 grid gap-8 lg:grid-cols-2">
          <div className="rounded-3xl border border-slate-200 bg-white p-8 shadow-sm">
            <h3 className="text-2xl font-bold text-slate-900">
              Sólidos dissolvidos totais
            </h3>

            <p className="mt-4 text-justify leading-8 text-slate-600">
              Os sólidos dissolvidos totais, frequentemente apresentados como
              TDS, representam a quantidade de substâncias dissolvidas na água.
              Referências veterinárias para suínos utilizam valores inferiores a
              1.000 ppm como referência desejável. Entretanto, a interpretação
              deve considerar os outros parâmetros da água e a situação
              específica da exploração.
            </p>
          </div>

          <div className="rounded-3xl border border-amber-200 bg-amber-50 p-8">
            <h3 className="text-2xl font-bold text-amber-950">
              Não avaliar apenas pela aparência
            </h3>

            <p className="mt-4 text-justify leading-8 text-amber-950/75">
              Uma água transparente pode apresentar problemas microbiológicos ou
              químicos que não são visíveis a olho nu. Da mesma forma, uma
              alteração de cor ou cheiro pode indicar um problema que precisa
              ser investigado, mas não permite determinar sozinho qual é o
              agente responsável.
            </p>
          </div>
        </div>
      </section>

      {/* COLETA */}
      <section className="bg-white py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="07"
            title="Como recolher água para análise"
          />

          <div className="grid gap-6 lg:grid-cols-4">
            <InfoCard title="01. Identificar a fonte">
              <p>
                Registar se a água vem de furo, rede pública, reservatório ou
                outra fonte.
              </p>
            </InfoCard>

            <InfoCard title="02. Avaliar o início da linha">
              <p>
                Uma amostra junto à fonte ajuda a avaliar a qualidade que entra
                no sistema.
              </p>
            </InfoCard>

            <InfoCard title="03. Avaliar o fim da linha">
              <p>
                Uma segunda amostra permite verificar se a qualidade muda ao
                longo da rede de distribuição.
              </p>
            </InfoCard>

            <InfoCard title="04. Registar resultados">
              <p>
                Data, ponto de recolha, fonte, resultados laboratoriais e
                intervenções devem ficar documentados.
              </p>
            </InfoCard>
          </div>
        </div>
      </section>

      {/* BEBEDOUROS */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <div className="grid gap-8 lg:grid-cols-2">
          <div>
            <SectionTitle
              number="08"
              title="O bebedouro também faz parte da sanidade"
              description="Mesmo uma água de boa qualidade pode tornar-se um problema produtivo se não chegar corretamente ao animal."
            />

            <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
              <p>
                O tipo de bebedouro, a pressão da rede, a altura, a localização
                e o fluxo determinam a facilidade com que o suíno consegue
                beber. Um fluxo muito baixo pode obrigar o animal a permanecer
                demasiado tempo junto ao bebedouro ou simplesmente reduzir o
                consumo.
              </p>

              <p>
                Por outro lado, um fluxo excessivamente elevado pode provocar
                desperdício, aumentar a humidade das instalações e contribuir
                para problemas de maneio. Por isso, não basta instalar um
                bebedouro e considerar o sistema concluído.
              </p>

              <p>
                O equipamento deve ser observado regularmente, especialmente
                depois de mudanças de lote, ajustes de altura, intervenções na
                rede ou alterações na pressão.
              </p>
            </div>
          </div>

          <div className="rounded-3xl bg-slate-900 p-8 text-white md:p-10">
            <h3 className="text-2xl font-bold">Sinais de problema</h3>

            <div className="mt-6 space-y-4">
              <div className="rounded-2xl bg-white/10 p-5">
                <strong className="text-green-300">
                  Fluxo insuficiente
                </strong>
                <p className="mt-2 text-sm leading-6 text-slate-300">
                  O animal demora demasiado para obter água ou abandona o
                  bebedouro.
                </p>
              </div>

              <div className="rounded-2xl bg-white/10 p-5">
                <strong className="text-green-300">
                  Fluxo excessivo
                </strong>
                <p className="mt-2 text-sm leading-6 text-slate-300">
                  Aumenta o desperdício e pode molhar excessivamente o piso.
                </p>
              </div>

              <div className="rounded-2xl bg-white/10 p-5">
                <strong className="text-green-300">
                  Bebedouro obstruído
                </strong>
                <p className="mt-2 text-sm leading-6 text-slate-300">
                  Pode reduzir drasticamente a disponibilidade real de água.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* BIOFILME */}
      <section className="bg-green-50 py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="09"
            title="Biofilme: um problema escondido nas tubagens"
          />

          <div className="grid gap-8 lg:grid-cols-[1fr_0.8fr]">
            <div className="rounded-3xl bg-white p-8 shadow-sm md:p-10">
              <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
                <p>
                  O biofilme é uma comunidade de microrganismos que se fixa a
                  superfícies húmidas, podendo desenvolver-se no interior das
                  linhas de água. É um problema particularmente importante
                  porque não é necessariamente visível sem inspeção adequada.
                </p>

                <p>
                  Com o tempo, matéria orgânica, minerais e microrganismos podem
                  acumular-se nas tubagens. Esse material pode favorecer a
                  persistência de contaminantes e reduzir a eficiência de
                  determinados processos de desinfeção.
                </p>

                <p>
                  A limpeza e a desinfeção devem ser consideradas etapas
                  diferentes. Primeiro é necessário remover sujidade e matéria
                  orgânica; posteriormente pode ser aplicado o procedimento de
                  desinfeção adequado ao sistema e ao produto utilizado.
                </p>

                <p>
                  Depois de qualquer intervenção, o produtor deve verificar se
                  o fluxo dos bebedouros permanece adequado.
                </p>
              </div>
            </div>

            <div className="rounded-3xl bg-green-900 p-8 text-white md:p-10">
              <p className="text-sm font-bold uppercase tracking-wider text-green-300">
                Regra prática
              </p>

              <h3 className="mt-4 text-3xl font-bold">
                Limpar primeiro. Desinfetar depois.
              </h3>

              <p className="mt-5 text-justify leading-8 text-green-50">
                A matéria orgânica pode reduzir a eficácia de determinados
                desinfetantes. Por isso, simplesmente adicionar um produto à
                água sem avaliar a limpeza do sistema não constitui uma
                estratégia completa de controlo.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* LEITÕES */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <div className="grid gap-8 lg:grid-cols-[0.8fr_1.2fr]">
          <div className="overflow-hidden rounded-3xl">
            <img
              src={imagens.leitões}
              alt="Leitões numa creche suinícola"
              className="h-full min-h-[400px] w-full object-cover"
            />
          </div>

          <div className="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200 md:p-10">
            <SectionTitle
              number="10"
              title="Leitões e água"
              description="A transição para o desmame representa uma fase crítica."
            />

            <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
              <p>
                Os leitões precisam aprender a utilizar o sistema de bebida.
                Quando são transferidos para uma nova instalação, o produtor
                deve verificar se os animais encontram facilmente o bebedouro e
                se conseguem ativá-lo.
              </p>

              <p>
                O período do desmame envolve várias mudanças simultâneas:
                separação da porca, alteração da dieta, mudança de ambiente,
                mistura de animais e adaptação às instalações. Qualquer
                dificuldade de acesso à água pode agravar o impacto dessa
                transição.
              </p>

              <p>
                Por isso, observar os leitões junto aos bebedouros, verificar o
                fluxo e acompanhar o consumo são medidas simples que podem
                ajudar a identificar problemas rapidamente.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* PORCAS */}
      <section className="bg-white py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="11"
            title="Porcas gestantes e lactantes"
          />

          <div className="grid gap-6 md:grid-cols-2">
            <InfoCard title="Gestação">
              <p>
                A porca deve ter acesso adequado à água durante toda a gestação.
                O consumo depende do tamanho do animal, dieta, temperatura e
                sistema de produção. A observação diária permite identificar
                mudanças anormais antes que se transformem num problema maior.
              </p>
            </InfoCard>

            <InfoCard title="Lactação">
              <p>
                A lactação é uma das fases de maior exigência. A produção de
                leite representa uma saída importante de água do organismo.
                Restrição de água pode reduzir o consumo de ração e a produção
                de leite, afetando diretamente os leitões.
              </p>
            </InfoCard>
          </div>
        </div>
      </section>

      {/* ÁGUA E DIARREIA */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <div className="rounded-3xl border border-red-200 bg-white p-8 shadow-sm md:p-10">
          <SectionTitle
            number="12"
            title="Água e problemas digestivos"
          />

          <div className="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
            <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-600">
              <p>
                Água contaminada pode contribuir para problemas gastrointestinais,
                mas é incorreto concluir automaticamente que toda diarreia numa
                exploração é causada pela água. A diarreia suína é
                multifatorial e pode envolver agentes infecciosos, alimentação,
                ambiente, idade, maneio, imunidade e outras condições.
              </p>

              <p>
                Quando ocorre um aumento de diarreia, a água deve ser incluída
                na investigação. É necessário verificar a fonte, reservatório,
                linhas, bebedouros e resultados laboratoriais, mas também
                investigar alimentação, higiene, densidade, idade dos animais e
                sinais clínicos.
              </p>

              <p>
                Esta abordagem evita dois erros frequentes: ignorar a água
                quando ela realmente participa do problema ou atribuir toda a
                doença à água sem evidência.
              </p>
            </div>

            <div className="rounded-2xl bg-red-50 p-7">
              <h3 className="text-xl font-bold text-red-950">
                Se houver diarreia, investigar:
              </h3>

              <ul className="mt-5 space-y-3 text-sm leading-6 text-red-950/75">
                <li>• Qualidade microbiológica da água.</li>
                <li>• Mudanças recentes na fonte.</li>
                <li>• Limpeza dos reservatórios.</li>
                <li>• Estado das tubagens.</li>
                <li>• Fluxo dos bebedouros.</li>
                <li>• Qualidade e alterações da alimentação.</li>
                <li>• Condições ambientais e de higiene.</li>
                <li>• Diagnóstico veterinário dos animais afetados.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* CALOR */}
      <section className="bg-slate-900 py-16 text-white">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="13"
            title="Água e calor nas condições de Angola"
          />

          <div className="grid gap-8 lg:grid-cols-3">
            <div className="lg:col-span-2">
              <div className="space-y-5 text-justify text-[16px] leading-8 text-slate-300">
                <p>
                  O ambiente térmico influencia diretamente o consumo de água.
                  À medida que a temperatura aumenta, os animais podem aumentar
                  a procura por água. Este fenómeno deve receber atenção
                  especial em regiões e períodos de maior calor.
                </p>

                <p>
                  Contudo, oferecer mais água não resolve sozinho o stress
                  térmico. Ventilação, sombra, densidade animal, características
                  das instalações e gestão do ambiente continuam fundamentais.
                </p>

                <p>
                  Uma exploração preparada para períodos de calor deve garantir
                  não apenas uma fonte de água, mas também capacidade de
                  distribuição. Se a bomba falhar, se o reservatório esvaziar
                  ou se a pressão cair durante as horas de maior consumo, a
                  disponibilidade real pode diminuir justamente quando os
                  animais mais precisam.
                </p>
              </div>
            </div>

            <div className="rounded-3xl bg-green-800 p-7">
              <h3 className="text-xl font-bold">Plano para dias quentes</h3>

              <ul className="mt-5 space-y-3 text-sm leading-6 text-green-50">
                <li>• Verificar reservatório.</li>
                <li>• Testar bombas.</li>
                <li>• Confirmar fluxo.</li>
                <li>• Verificar todos os bebedouros.</li>
                <li>• Monitorizar consumo.</li>
                <li>• Garantir ventilação adequada.</li>
                <li>• Ter fonte alternativa de emergência.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      {/* MONITORIZAÇÃO */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <SectionTitle
          number="14"
          title="Monitorizar o consumo de água"
          description="A água pode funcionar como um indicador precoce de alterações na exploração."
        />

        <div className="grid gap-6 md:grid-cols-3">
          <InfoCard title="Consumo reduzido">
            <p>
              Pode indicar problema de acesso, falha no bebedouro, alteração da
              água, doença, alteração ambiental ou mudança no consumo de ração.
            </p>
          </InfoCard>

          <InfoCard title="Consumo aumentado">
            <p>
              Pode ocorrer com temperaturas elevadas, aumento de consumo de
              alimento, lactação ou determinadas condições sanitárias.
            </p>
          </InfoCard>

          <InfoCard title="Mudança repentina">
            <p>
              Alterações bruscas merecem investigação. O objetivo não é
              diagnosticar uma doença apenas pelo consumo, mas utilizar a
              informação como sinal de alerta.
            </p>
          </InfoCard>
        </div>

        <div className="mt-8 rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200 md:p-10">
          <h3 className="text-2xl font-bold">Registo recomendado</h3>

          <div className="mt-6 overflow-x-auto">
            <table className="w-full min-w-[700px] border-collapse">
              <thead>
                <tr className="border-b border-slate-200 text-left text-sm">
                  <th className="px-4 py-3">Data</th>
                  <th className="px-4 py-3">Lote</th>
                  <th className="px-4 py-3">Consumo</th>
                  <th className="px-4 py-3">Temperatura</th>
                  <th className="px-4 py-3">Observações</th>
                </tr>
              </thead>

              <tbody>
                <tr className="border-b border-slate-100 text-sm text-slate-600">
                  <td className="px-4 py-4">Registar</td>
                  <td className="px-4 py-4">Registar</td>
                  <td className="px-4 py-4">Medir</td>
                  <td className="px-4 py-4">Registar</td>
                  <td className="px-4 py-4">
                    Saúde, instalações e alterações
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {/* EMERGÊNCIA */}
      <section className="bg-amber-50 py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="15"
            title="O que fazer quando falta água?"
          />

          <div className="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
            <InfoCard title="1. Confirmar a causa">
              <p>
                Verificar fonte, bomba, energia, reservatório, pressão e
                tubagem.
              </p>
            </InfoCard>

            <InfoCard title="2. Garantir abastecimento">
              <p>
                Utilizar a fonte ou reserva alternativa disponível e segura.
              </p>
            </InfoCard>

            <InfoCard title="3. Priorizar animais">
              <p>
                Dar atenção imediata aos grupos de maior exigência, sobretudo
                animais lactantes e grupos expostos ao calor.
              </p>
            </InfoCard>

            <InfoCard title="4. Registar o incidente">
              <p>
                Anotar duração, causa, animais afetados e medidas tomadas para
                prevenir repetição.
              </p>
            </InfoCard>
          </div>
        </div>
      </section>

      {/* CHECKLIST */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <SectionTitle
          number="16"
          title="Checklist de gestão da água"
          description="Uma rotina simples pode transformar a água num indicador de gestão da exploração."
        />

        <div className="grid gap-6 md:grid-cols-2">
          <div className="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <h3 className="text-2xl font-bold">Todos os dias</h3>

            <ul className="mt-6 space-y-4 text-justify text-sm leading-7 text-slate-600">
              <li>□ Verificar se todos os bebedouros funcionam.</li>
              <li>□ Observar comportamento dos animais junto à água.</li>
              <li>□ Verificar fugas e água acumulada no piso.</li>
              <li>□ Observar alterações de cor ou cheiro.</li>
              <li>□ Confirmar disponibilidade no reservatório.</li>
              <li>□ Registar alterações importantes.</li>
            </ul>
          </div>

          <div className="rounded-3xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <h3 className="text-2xl font-bold">Periodicamente</h3>

            <ul className="mt-6 space-y-4 text-justify text-sm leading-7 text-slate-600">
              <li>□ Avaliar fluxo dos bebedouros.</li>
              <li>□ Inspecionar tubagens.</li>
              <li>□ Limpar reservatórios.</li>
              <li>□ Verificar presença de biofilme e sedimentos.</li>
              <li>□ Rever funcionamento das bombas.</li>
              <li>□ Realizar análises laboratoriais conforme risco.</li>
            </ul>
          </div>
        </div>
      </section>

      {/* INVESTIGAÇÃO */}
      <section className="bg-white py-16">
        <div className="mx-auto max-w-7xl px-5 md:px-8">
          <SectionTitle
            number="17"
            title="Temas de investigação para estudantes e técnicos"
          />

          <div className="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            <InfoCard title="Qualidade da água">
              <p>
                Comparar parâmetros microbiológicos e físico-químicos entre
                diferentes sistemas de produção suína em Angola.
              </p>
            </InfoCard>

            <InfoCard title="Água e desempenho">
              <p>
                Estudar relações entre consumo de água, consumo de alimento,
                ganho de peso e conversão alimentar.
              </p>
            </InfoCard>

            <InfoCard title="Água e clima">
              <p>
                Avaliar alterações no consumo durante períodos de maior
                temperatura e diferentes regiões agroclimáticas.
              </p>
            </InfoCard>

            <InfoCard title="Biofilme">
              <p>
                Investigar condições de formação de biofilme em redes de água e
                métodos de controlo adequados às explorações locais.
              </p>
            </InfoCard>

            <InfoCard title="Água e diarreia">
              <p>
                Avaliar fatores de risco relacionados com água e doenças
                entéricas sem confundir associação com causalidade.
              </p>
            </InfoCard>

            <InfoCard title="Gestão económica">
              <p>
                Quantificar perdas relacionadas com fugas, desperdício e
                sistemas de distribuição mal dimensionados.
              </p>
            </InfoCard>
          </div>
        </div>
      </section>

      {/* FONTES */}
      <section className="mx-auto max-w-7xl px-5 py-16 md:px-8">
        <div className="rounded-3xl bg-slate-900 p-8 text-white md:p-10">
          <p className="text-sm font-bold uppercase tracking-[0.2em] text-green-300">
            Base técnica
          </p>

          <h2 className="mt-3 text-3xl font-bold">
            Fontes utilizadas nesta orientação
          </h2>

          <div className="mt-8 grid gap-4 md:grid-cols-2">
            <a
              href="https://www.msdvetmanual.com/management-and-nutrition/nutrition-pigs/nutritional-requirements-of-pigs"
              target="_blank"
              rel="noreferrer"
              className="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:bg-white/10"
            >
              <strong>MSD Veterinary Manual</strong>
              <p className="mt-2 text-sm leading-6 text-slate-300">
                Necessidades nutricionais e importância fisiológica da água
                para suínos.
              </p>
            </a>

            <a
              href="https://extension.sdstate.edu/considerations-water-sustainable-swine-production"
              target="_blank"
              rel="noreferrer"
              className="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:bg-white/10"
            >
              <strong>South Dakota State University Extension</strong>
              <p className="mt-2 text-sm leading-6 text-slate-300">
                Gestão da água, bebedouros, fluxo e qualidade na produção
                suína.
              </p>
            </a>

            <a
              href="https://www.gov.uk/government/publications/pigs-code-of-practice-for-the-welfare-of-pigs"
              target="_blank"
              rel="noreferrer"
              className="rounded-2xl border border-white/10 bg-white/5 p-5 transition hover:bg-white/10"
            >
              <strong>UK Government — Code of Practice for Pigs</strong>
