import Link from "next/link";
import { redirect } from "next/navigation";
import { administradorAutenticado } from "@/lib/admin-auth";

export const dynamic = "force-dynamic";

export default async function AdminNoticiasPage() {
  const autenticado = await administradorAutenticado();

  if (!autenticado) {
    redirect("/login");
  }

  return (
    <main className="min-h-screen bg-slate-100 px-4 py-8 text-slate-800 md:px-8">
      <div className="mx-auto max-w-7xl">
        <div className="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="text-sm font-bold uppercase tracking-[0.2em] text-emerald-700">
              AGROINOVA ANGOLA
            </p>
            <h1 className="mt-2 text-3xl font-bold">
              Gestão de notícias
            </h1>
            <p className="mt-2 text-slate-600">
              Acompanha as notícias recolhidas pelas fontes e consulta a página pública.
            </p>
          </div>

          <Link
            href="/admin"
            className="rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold transition hover:bg-slate-50"
          >
            Voltar ao painel
          </Link>
        </div>

        <section className="grid gap-5 md:grid-cols-3">
          <article className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div className="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800">
              <span className="text-xl font-bold">01</span>
            </div>
            <h2 className="text-lg font-bold">Notícias públicas</h2>
            <p className="mt-2 text-sm leading-6 text-slate-600">
              Abre a página pública para consultar os artigos disponibilizados pela API.
            </p>
            <Link
              href="/noticias"
              className="mt-5 inline-flex rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white transition hover:bg-emerald-800"
            >
              Abrir notícias
            </Link>
          </article>

          <article className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <div className="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-blue-100 text-blue-800">
              <span className="text-xl font-bold">02</span>
            </div>
            <h2 className="text-lg font-bold">Fontes e atualização</h2>
            <p className="mt-2 text-sm leading-6 text-slate-600">
              Consulta o estado da API, o número de notícias encontradas e os erros das fontes.
            </p>
            <a
              href="/api/noticias"
              target="_blank"
              rel="noreferrer"
              className="mt-5 inline-flex rounded-lg bg-slate-800 px-4 py-2.5 font-semibold text-white transition hover:bg-slate-900"
            >
              Ver diagnóstico da API
            </a>
          </article>

          <article className="rounded-2xl border border-amber-200 bg-amber-50 p-6 shadow-sm">
            <div className="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-amber-100 text-amber-800">
              <span className="text-xl font-bold">03</span>
            </div>
            <h2 className="text-lg font-bold">Publicações próprias</h2>
            <p className="mt-2 text-sm leading-6 text-slate-700">
              A criação, edição e remoção de notícias próprias exige armazenamento persistente
              e uma base de dados. Não serão simuladas ações que ainda não estejam implementadas.
            </p>
          </article>
        </section>

        <section className="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 className="text-xl font-bold">Como funciona a publicação</h2>
          <div className="mt-4 grid gap-4 md:grid-cols-3">
            <div className="rounded-xl bg-slate-50 p-4">
              <p className="font-semibold">1. Recolha</p>
              <p className="mt-2 text-sm leading-6 text-slate-600">
                A API consulta os sites de notícias configurados.
              </p>
            </div>
            <div className="rounded-xl bg-slate-50 p-4">
              <p className="font-semibold">2. Verificação</p>
              <p className="mt-2 text-sm leading-6 text-slate-600">
                O administrador pode verificar os resultados e os erros de consulta.
              </p>
            </div>
            <div className="rounded-xl bg-slate-50 p-4">
              <p className="font-semibold">3. Consulta pública</p>
              <p className="mt-2 text-sm leading-6 text-slate-600">
                A página de notícias apresenta os dados disponibilizados pela API.
              </p>
            </div>
          </div>
        </section>
      </div>
    </main>
  );
