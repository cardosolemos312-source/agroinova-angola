export default function ProvinciasPage() {
  const [provinciaSelecionada, setProvinciaSelecionada] = useState<string | null>(null);
  const [separador, setSeparador] = useState("Visão geral");

  const provincia = provincias.find((p) => p.nome === provinciaSelecionada);
  const slugSelecionado = provinciaSelecionada
    ? provinciaSelecionada.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/\s+/g, "-")
    : "";

  const ficha = fichas[slugSelecionado];

  function abrirProvincia(nome: string) {
    setProvinciaSelecionada(nome);
    setSeparador("Visão geral");
  }

  function fecharProvincia() {
    setProvinciaSelecionada(null);
  }

  const conteudoSelecionado = ficha?.secoes.find((secao) => {
    const correspondencia: Record<string, string> = {
      "Geografia": "Geografia e território",
      "Clima e água": "Clima e recursos hídricos",
      "Agricultura": "Agricultura e culturas",
      "Pecuária": "Pecuária",
      "Pesca": "Pesca e aquicultura",
      "Florestas": "Florestas e biodiversidade",
      "Economia": "Economia e agro-indústria",
      "Investigação": "Desafios e prioridades de investigação"
    };

    return secao.titulo === correspondencia[separador];
  });

  return (
    <main className="min-h-screen bg-[#f1f5f1] text-[#17221b]">
      <header className="relative overflow-hidden bg-gradient-to-r from-green-950 via-green-900 to-emerald-800 text-white">
        <div className="absolute inset-0 opacity-20">
          <div className="absolute -right-20 -top-28 h-96 w-96 rounded-full border-[45px] border-green-300" />
          <div className="absolute -bottom-48 right-1/4 h-96 w-96 rounded-full border-[35px] border-lime-300" />
        </div>

        <div className="relative mx-auto max-w-7xl px-5 py-5">
          <nav className="flex flex-wrap items-center justify-between gap-4 border-b border-white/15 pb-5">
            <Link href="/" className="text-2xl font-black tracking-tight">
              AGROINOVA <span className="text-lime-300">ANGOLA</span>
            </Link>

            <div className="flex flex-wrap gap-3 text-sm font-semibold md:gap-6">
              <Link href="/" className="hover:text-lime-300">Início</Link>
              <Link href="/mapa" className="hover:text-lime-300">Mapa Agrícola</Link>
              <Link href="/provincias" className="text-lime-300">Províncias</Link>
              <Link href="/dados" className="hover:text-lime-300">Dados</Link>
            </div>
          </nav>

          <div className="grid items-center gap-8 py-12 md:grid-cols-[1.2fr_0.8fr] md:py-16">
            <div>
              <span className="inline-flex rounded-full bg-lime-400/20 px-4 py-2 text-xs font-bold uppercase tracking-[0.18em] text-lime-200">
                Território • Conhecimento • Inovação
              </span>

              <h1 className="mt-5 text-4xl font-black leading-tight md:text-6xl">
                Províncias de <span className="text-lime-300">Angola</span>
              </h1>

              <p className="mt-5 max-w-2xl text-base leading-8 text-green-50 md:text-lg">
                Explore as 21 províncias de Angola através de informação
                territorial, demográfica, agrícola, pecuária, ambiental e económica.
              </p>

              <div className="mt-7 flex flex-wrap gap-3">
                <a href="#lista-provincias" className="rounded-xl bg-lime-400 px-6 py-3 font-bold text-green-950 shadow-lg transition hover:bg-lime-300">
                  Explorar províncias ↓
                </a>
                <Link href="/mapa" className="rounded-xl border border-white/40 px-6 py-3 font-bold text-white transition hover:bg-white/10">
                  Abrir mapa agrícola
                </Link>
              </div>
            </div>

            <div className="rounded-3xl border border-white/20 bg-white/10 p-3 shadow-2xl backdrop-blur-sm">
              <img
                src="https://images.openai.com/static-rsc-4/WH-K_92qscj6iw2iUJQBijxVKnmsZdnnqtmYpqmE8hj4Cj3VlGzE_g6rSaZAOkTd9kjSiemrbc9QufbIlFk8a3bJVNFSWtaNDSoSx6xq-dnGXdafHpr4_AoKhKB9GA9dALnYnR0q2_07uKqEdNhIA6mWeRMwWFtmdvv7r3JYkyhDwjwF9fhOa1bUY_I_a7YN?purpose=fullsize"
                alt="Paisagem agrícola e campos verdes de Angola"
                className="h-64 w-full rounded-2xl object-cover md:h-80"
              />

              <div className="flex items-center justify-between gap-3 px-3 py-4">
                <div>
                  <p className="text-lg font-bold">Conhecimento territorial</p>
                  <p className="mt-1 text-sm text-green-100">Agricultura, pecuária e recursos naturais</p>
                </div>
                <div className="rounded-xl bg-lime-400 px-4 py-3 text-center text-green-950">
                  <strong className="block text-2xl">21</strong>
                  <span className="text-xs font-bold">Províncias</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <section id="lista-provincias" className="mx-auto max-w-7xl px-5 py-12 md:py-16">
        <div className="mb-8">
          <p className="text-sm font-bold uppercase tracking-[0.18em] text-green-700">
            Exploração territorial
          </p>
          <h2 className="mt-2 text-3xl font-black text-green-950 md:text-4xl">
            Conheça cada província
          </h2>
          <p className="mt-3 max-w-3xl leading-7 text-slate-600">
            Seleccione uma província para consultar a sua ficha territorial,
            características naturais, actividades produtivas, oportunidades
            económicas e prioridades de investigação.
          </p>
        </div>

        <div className="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {provincias.map((item, indice) => {
            const slug = item.nome
              .normalize("NFD")
              .replace(/[\u0300-\u036f]/g, "")
              .toLowerCase()
              .replace(/\s+/g, "-");

            return (
              <article
                key={item.nome}
                className="group overflow-hidden rounded-2xl border border-white bg-white shadow-[0_8px_25px_rgba(15,60,30,0.09)] transition duration-300 hover:-translate-y-2 hover:shadow-[0_18px_38px_rgba(15,60,30,0.2)]"
              >
                <div className="relative h-52 overflow-hidden">
                  <img
                    src={item.imagem}
                    alt={`Paisagem ilustrativa de ${item.nome}`}
                    loading={indice < 4 ? "eager" : "lazy"}
                    className="h-full w-full object-cover transition duration-700 group-hover:scale-110"
                  />

                  <div className={`absolute inset-0 bg-gradient-to-t ${item.cor} via-black/25 to-transparent`} />

                  <span className="absolute left-4 top-4 rounded-full border border-white/30 bg-black/25 px-3 py-1.5 text-xs font-bold text-white backdrop-blur-md">
                    Província {String(indice + 1).padStart(2, "0")}
                  </span>

                  <h3 className="absolute bottom-4 left-5 text-2xl font-black text-white drop-shadow-lg">
                    {item.nome}
                  </h3>
                </div>

                <div className="p-5">
                  <p className="min-h-[52px] text-sm leading-6 text-slate-600">
                    {item.descricao}
                  </p>

                  <button
                    type="button"
                    onClick={() => abrirProvincia(item.nome)}
                    className="mt-5 flex w-full items-center justify-between rounded-xl bg-green-50 px-4 py-3 text-left font-bold text-green-900 transition hover:bg-green-800 hover:text-white"
                  >
                    <span>Explorar província</span>
                    <span aria-hidden="true">→</span>
                  </button>
                </div>
              </article>
            );
          })}
        </div>

        <div className="mt-12 rounded-3xl bg-gradient-to-r from-green-900 to-emerald-800 p-7 text-white shadow-xl md:flex md:items-center md:justify-between md:gap-8 md:p-10">
          <div>
            <h2 className="text-2xl font-black md:text-3xl">
              Explore Angola através dos dados
            </h2>
            <p className="mt-3 max-w-2xl leading-7 text-green-100">
              Consulte o mapa agrícola e acompanhe a informação territorial,
              produtiva e ambiental disponibilizada pela AGROINOVA.
            </p>
          </div>

          <Link href="/mapa" className="mt-6 inline-flex shrink-0 rounded-xl bg-lime-400 px-6 py-3 font-bold text-green-950 transition hover:bg-lime-300 md:mt-0">
            Ir para o mapa →
          </Link>
        </div>
      </section>

      <footer className="bg-green-950 px-5 py-7 text-center text-sm text-green-100">
        <p className="font-bold tracking-wide">AGROINOVA ANGOLA</p>
        <p className="mt-2">Conhecimento, Tecnologia e Inovação ao Serviço do Campo Angolano.</p>
      </footer>

      {provinciaSelecionada && provincia && ficha && (
        <div
          className="fixed inset-0 z-[100] flex items-start justify-center overflow-y-auto bg-black/75 p-3 backdrop-blur-sm md:p-6"
          onClick={(e) => {
            if (e.target === e.currentTarget) fecharProvincia();
          }}
        >
          <section
            role="dialog"
            aria-modal="true"
            aria-labelledby="titulo-ficha-provincia"
            className="my-3 w-full max-w-6xl overflow-hidden rounded-3xl bg-[#f7faf7] shadow-2xl md:my-8"
          >
            <div className="relative h-64 overflow-hidden md:h-80">
              <img
                src={provincia.imagem}
                alt={`Paisagem de ${provinciaSelecionada}`}
                className="h-full w-full object-cover"
              />

              <div className="absolute inset-0 bg-gradient-to-t from-green-950 via-green-950/45 to-black/10" />

              <button
                type="button"
                onClick={fecharProvincia}
                aria-label="Fechar ficha da província"
                className="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full border border-white/40 bg-black/40 text-2xl text-white transition hover:bg-white hover:text-green-950"
              >
                ×
              </button>

              <div className="absolute bottom-0 left-0 right-0 p-6 text-white md:p-9">
                <p className="text-xs font-bold uppercase tracking-[0.2em] text-lime-300">
                  Ficha territorial AGROINOVA
                </p>
                <h2 id="titulo-ficha-provincia" className="mt-2 text-4xl font-black md:text-5xl">
                  {provinciaSelecionada}
                </h2>
                <p className="mt-2 max-w-3xl text-sm leading-6 text-green-50 md:text-base">
                  {ficha.perfil}
                </p>
              </div>
            </div>

            <div className="grid gap-4 border-b border-green-100 bg-white p-5 sm:grid-cols-3 md:p-7">
              <div className="rounded-xl bg-green-50 p-4">
                <p className="text-xs font-bold uppercase tracking-wide text-green-700">Capital provincial</p>
                <p className="mt-2 text-lg font-black text-green-950">{ficha.capital}</p>
              </div>

              <div className="rounded-xl bg-green-50 p-4">
                <p className="text-xs font-bold uppercase tracking-wide text-green-700">População — Censo 2024</p>
                <p className="mt-2 text-lg font-black text-green-950">
                  {populacoes[provinciaSelecionada] || ficha.populacao}
                </p>
              </div>

              <div className="rounded-xl bg-green-50 p-4">
                <p className="text-xs font-bold uppercase tracking-wide text-green-700">Área de conhecimento</p>
                <p className="mt-2 text-lg font-black text-green-950">Desenvolvimento territorial</p>
              </div>
            </div>

            <div className="sticky top-0 z-10 border-b border-green-100 bg-white px-4 py-3">
              <div className="flex gap-2 overflow-x-auto pb-1">
                {separadores.map((item) => (
                  <button
                    key={item}
                    type="button"
                    onClick={() => setSeparador(item)}
                    className={`shrink-0 rounded-full px-4 py-2 text-sm font-bold transition ${
                      separador === item
                        ? "bg-green-800 text-white"
                        : "bg-green-50 text-green-900 hover:bg-green-100"
                    }`}
                  >
                    {item}
                  </button>
                ))}
              </div>
            </div>

            <div className="p-5 md:p-8">
              {separador === "Visão geral" ? (
                <div className="space-y-7">
                  <div>
                    <p className="text-xs font-bold uppercase tracking-[0.18em] text-green-700">
                      Enquadramento provincial
                    </p>
                    <h3 className="mt-2 text-2xl font-black text-green-950">
                      Conhecer o território
                    </h3>
                    <p className="mt-4 text-base leading-8 text-slate-700">
                      {ficha.enquadramento}
                    </p>
                  </div>

                  <div className="grid gap-5 md:grid-cols-2">
                    <div className="overflow-hidden rounded-2xl bg-white shadow-sm">
                      <img
                        src={provincia.imagem}
                        alt={`Paisagem e território de ${provinciaSelecionada}`}
                        className="h-56 w-full object-cover"
                      />
                      <div className="p-4">
                        <h4 className="font-black text-green-950">Paisagem provincial</h4>
                        <p className="mt-2 text-sm leading-6 text-slate-600">
                          Imagem de referência visual do território. A paisagem
                          apresentada é ilustrativa e não substitui cartografia
                          ou levantamento geográfico oficial.
                        </p>
                      </div>
                    </div>

                    <div className="rounded-2xl border border-green-100 bg-white p-5">
                      <h4 className="text-lg font-black text-green-950">
                        Perfil de desenvolvimento
                      </h4>
                      <p className="mt-3 leading-7 text-slate-700">
                        {ficha.perfil}
                      </p>
                      <div className="mt-5 border-t border-green-100 pt-4">
                        <p className="text-sm font-bold text-green-800">
                          Áreas a acompanhar
                        </p>
                        <ul className="mt-3 space-y-2 text-sm leading-6 text-slate-600">
                          <li>• Produção agrícola e segurança alimentar</li>
                          <li>• Pecuária e saúde animal</li>
                          <li>• Recursos naturais e ambiente</li>
                          <li>• Infra-estruturas e mercados</li>
                          <li>• Investigação e inovação tecnológica</li>
                        </ul>
                      </div>
                    </div>
                  </div>

                  <div className="rounded-2xl bg-green-950 p-6 text-white">
                    <h4 className="text-xl font-black">Objectivo da ficha provincial</h4>
                    <p className="mt-3 leading-7 text-green-50">
                      Reunir conhecimento territorial, produtivo, ambiental e
                      económico para apoiar agricultores, técnicos, investigadores,
                      instituições públicas, investidores e agentes da cadeia
                      agroalimentar.
                    </p>
                  </div>
                </div>
              ) : conteudoSelecionado ? (
                <article className="max-w-4xl">
                  <p className="text-xs font-bold uppercase tracking-[0.18em] text-green-700">
                    {provinciaSelecionada} • Conhecimento provincial
                  </p>
                  <h3 className="mt-2 text-3xl font-black text-green-950">
                    {conteudoSelecionado.titulo}
                  </h3>

                  <div className="mt-6 space-y-5">
                    {conteudoSelecionado.conteudo.map((paragrafo, index) => (
                      <p key={index} className="text-base leading-8 text-slate-700">
                        {paragrafo}
                      </p>
                    ))}
                  </div>

                  <div className="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm">
                    <img
                      src={provincia.imagem}
                      alt={`Imagem ilustrativa de ${conteudoSelecionado.titulo.toLowerCase()} em ${provinciaSelecionada}`}
                      className="h-64 w-full object-cover"
                    />
                    <div className="p-4">
                      <h4 className="font-bold text-green-950">
                        {conteudoSelecionado.titulo} — {provinciaSelecionada}
                      </h4>
                      <p className="mt-2 text-sm leading-6 text-slate-600">
                        Imagem ilustrativa para contextualização da secção.
                        A identificação de culturas, espécies, infra-estruturas
                        ou locais específicos requer fotografia documental
                        devidamente identificada.
                      </p>
                    </div>
                  </div>
                </article>
              ) : (
                <p className="py-10 text-center text-slate-600">
                  Informação desta secção em preparação.
                </p>
              )}

              <div className="mt-10 border-t border-green-100 pt-6">
                <h4 className="font-black text-green-950">Fontes e enquadramento dos dados</h4>
                <p className="mt-2 text-sm leading-7 text-slate-600">
                  População: Recenseamento Geral da População e Habitação de
                  Angola 2024, Instituto Nacional de Estatística (INE). As
                  descrições sectoriais desta ficha representam enquadramento
                  territorial e potencial produtivo; não devem ser interpretadas
                  como estatísticas de produção provincial sem confirmação em
                  fontes sectoriais oficiais.
                </p>

                <div className="mt-4 flex flex-wrap gap-3">
                  <a
                    href="https://censo2024.ine.gov.ao/"
                    target="_blank"
                    rel="noreferrer"
                    className="rounded-lg border border-green-200 px-4 py-2 text-sm font-bold text-green-900 hover:bg-green-50"
                  >
                    Consultar Censo 2024 ↗
                  </a>
                  <a
                    href="https://www.ine.gov.ao/"
                    target="_blank"
                    rel="noreferrer"
                    className="rounded-lg border border-green-200 px-4 py-2 text-sm font-bold text-green-900 hover:bg-green-50"
                  >
                    Portal do INE ↗
                  </a>
                </div>
              </div>
            </div>

            <div className="flex flex-wrap items-center justify-between gap-3 border-t border-green-100 bg-white px-5 py-4 md:px-8">
              <p className="text-xs text-slate-500">
                AGROINOVA ANGOLA • Conhecimento, Tecnologia e Inovação
              </p>
              <button
                type="button"
                onClick={fecharProvincia}
                className="rounded-xl bg-green-800 px-5 py-3 text-sm font-bold text-white transition hover:bg-green-950"
              >
                Fechar ficha
              </button>
            </div>
          </section>
        </div>
      )}
    </main>
  );
}

const provincias = [
{ nome: "Bengo", cor: "from-emerald-950", imagem: "https://images.openai.com/static-rsc-4/mFdKHQsaY1NvF6s7k6WWeoMg9i-iYTraTK07b9g2FCUAsVhGb1-TKUtFYMkj4RikxCcgFyOJXqFbxyhXTXCBSi1kj2Bng3vdmcsXe__XuJJGXsp_d8RIgphzqQvWRKarh78g9DXsnNKpAqro9rC7Yn0N6YVp9l-sVvm3sLz4Ut21yBGachicZW5g0mbbwNPm?purpose=fullsize", descricao: "Recursos naturais, agricultura e potencial florestal." },
{ nome: "Benguela", cor: "from-sky-950", imagem: "https://images.openai.com/static-rsc-4/5Gfj8QBOVCv8AJHIYYrqTXmi3O1Rg2aIr-VA8qDRQwRjXtvNTbrBwMfQVnRSGF6YNZiiRvHy9nY_PoS5N_fu4qXUl13XXrqjm4Rq4Waj6kmMVZpWpXkZ4tqtArQLNQPMLUB9BAi-VLGEkghszOu2rP508dUQmxO7P8S57ZrpQopubq5Rq26-OqK7FkPsYvzQ?purpose=fullsize", descricao: "Pesca, horticultura, pecuária e atividade costeira." },
