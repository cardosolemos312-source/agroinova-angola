{ nome: "Luanda", cor: "from-cyan-950", imagem: "https://images.openai.com/static-rsc-4/ZMEcx861NvII0fkAlJJATHuk22FF5fgTfUZlJle5hBWAtHSINWw5BU1CHPVJXarDxH13nxo3wBTCYJxX0MWNJxwmsCGSfveKjeP8AJzWD-dRJDVvR2L0Rs31dVyTriENoKc_t7oSFEJ-4mKfJg1_h6lWadMhdrJH6yYdHkrPPOH5TrADQ2cDcXFLBS_RDNQm?purpose=fullsize", descricao: "Mercados, abastecimento e agricultura periurbana." },
