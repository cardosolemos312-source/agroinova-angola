{ nome: "Cubango", cor: "from-green-950", imagem: "https://images.openai.com/static-rsc-4/igI_M5DOZtrogVRzMUwFZbrqvZFpXl1xY5m1ACfvzpPlh33zqHpYl1lpcwHUHLV_C9M7bwGut0oVChcoPW2iwK6D1PzAP0BygDkf4BxPjyr4btqqtI6UVaUVe46En_CjvzRMU_SayQejEUMpiuuydajsQ6tBZ5PHDV61dQSHq9B02SL00Zvkt6uJboen_QnZ?purpose=fullsize", descricao: "Ecossistemas naturais e atividade agropecuária." },
{ nome: "Cuanza Norte", cor: "from-teal-950", imagem: "https://images.openai.com/static-rsc-4/NSQl8FrrF9oi2y0FsfuN-u6Uoy1Hq5yR2syuEG9y2p0eyWhEOs6xFKG4QIsAXdFpwzoUgWnpaWMOGWLEEKtqHJ_C3ZxfcuyttXDdZf69cJW2yNJVyYHU_71VrSPTLyRTZqy0J0hBFh6xJ2zEHZqeSJWeNNmhza28CE-dbyKB1lxh4BSIMynSSsiJtOcDNveP?purpose=fullsize", descricao: "Agricultura diversificada e recursos hídricos." },
