{ nome: "Huíla", cor: "from-blue-950", imagem: "https://images.openai.com/static-rsc-4/mZ_rxM-4P0LSW8agxFh4GQL0Z1SHF8yY8woF24lmv5oQqjCoN-trqdmTam-vWc70SJtWQue9M_2AQgxMhyR1CzpUX-EiGSNxRClgO7Uwo5KsA8deUd1rVHmtkH2kfmA9OqZzqUpgfl9ebWSr9zPvCxB2ee4hYSlMHlyZBUgptNbKAiyMINpkK4yIbdHJGnRW?purpose=fullsize", descricao: "Pecuária, cereais e diversidade de paisagens." },
