{ nome: "Cabinda", cor: "from-purple-950", imagem: "https://images.openai.com/static-rsc-4/KSK_NMjMerzxG_1q6Gjo2eaoFkWKS0IDKDKqVT2XP-7MCebF9XHvvb1UL8vcVsuyxP9qX1Ba2l6FZAx4412nukC_229jlhQeNiSW05Q867d53_EYfaC0tCDZqz04DT_lbWKYzNwMjIwwMoGwzBzWxaZTJrvrqw3_EdFiVm1bCaUHPAU2eRSWPKIDQTRxVxQz?purpose=fullsize", descricao: "Florestas tropicais e biodiversidade." },
