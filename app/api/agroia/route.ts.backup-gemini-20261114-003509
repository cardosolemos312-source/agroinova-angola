import { NextRequest, NextResponse } from "next/server";

export const runtime = "nodejs";
export const maxDuration = 30;

const GEMINI_MODEL = "gemini-3.1-flash-lite";
const TIMEOUT_MS = 25000;
const MAX_DESCRICAO = 1000;

function textoSeguro(valor: unknown, padrao = ""): string {
  if (typeof valor !== "string") return padrao;
  return valor.trim();
}

function removerRepeticoes(texto: string): string {
  const linhas = texto.replace(/\r\n/g, "\n").split("\n");
  const resultado: string[] = [];

  for (const linha of linhas) {
    const atual = linha.trim();

    if (
      atual &&
      resultado.length > 0 &&
      resultado[resultado.length - 1].trim() === atual
    ) {
      continue;
    }

    resultado.push(linha);
  }

  return resultado.join("\n").trim();
}

export async function POST(request: NextRequest) {
  const apiKey = process.env.GEMINI_API_KEY;

  if (!apiKey) {
    return NextResponse.json(
      { sucesso: false, erro: "A configuração da inteligência artificial não está disponível." },
      { status: 503 }
    );
  }

  const controller = new AbortController();
  let timeout: ReturnType<typeof setTimeout> | undefined;

  try {
    let body: unknown;

    try {
      body = await request.json();
    } catch {
      return NextResponse.json(
        { sucesso: false, erro: "Pedido inválido. Actualiza a página e tenta novamente." },
        { status: 400 }
      );
    }

    if (!body || typeof body !== "object" || Array.isArray(body)) {
      return NextResponse.json(
        { sucesso: false, erro: "Os dados enviados são inválidos." },
        { status: 400 }
      );
    }

    const dados = body as Record<string, unknown>;

    const descricao = textoSeguro(dados.descricao);
    const provincia = textoSeguro(dados.provincia, "Não informada");
    const municipio = textoSeguro(dados.municipio, "Não informado");
    const cultura = textoSeguro(dados.cultura, "Não informada");
    const atividade = textoSeguro(dados.atividade, "Não informada");
    const imagem = dados.imagem;

    if (!descricao && !imagem) {
      return NextResponse.json(
        { sucesso: false, erro: "Descreve o problema para iniciar a análise." },
        { status: 400 }
      );
    }

    if (imagem) {
      return NextResponse.json(
        {
          sucesso: false,
          erro: "A análise de fotografias ainda não está disponível. Descreve os sintomas observados."
        },
        { status: 400 }
      );
    }

    if (descricao.length > MAX_DESCRICAO) {
      return NextResponse.json(
        { sucesso: false, erro: "Resume a descrição em até 1000 caracteres." },
        { status: 400 }
      );
    }

    const prompt = `
És a AGROINOVA IA (AGROIA), assistente de conhecimento agropecuário de Angola.

Responde sempre em português de Angola. Sê claro, directo e tecnicamente prudente.

Cultura: ${cultura}
Província: ${provincia}
Município: ${municipio}
Actividade: ${atividade}
Pergunta ou problema: ${descricao}

REGRAS:
- Responde ao assunto apresentado.
- Dá orientações práticas adaptadas às condições agrícolas de Angola.
- Distingue recomendações gerais de informações confirmadas.
- Nunca inventes estatísticas, fontes, doenças ou tratamentos.
- Não apresentes hipóteses como diagnósticos confirmados.
- Para recomendações de pesticidas ou medicamentos, recomenda orientação técnica e cumprimento do rótulo e das normas aplicáveis.
- Se faltarem informações essenciais, pede esclarecimentos.
- Usa linguagem acessível aos agricultores.
- Não ultrapasses 250 palavras.

FORMATO:
Organiza a resposta com títulos curtos quando forem úteis.
`;

    console.log("AGROIA: a iniciar consulta Gemini.");

    timeout = setTimeout(() => controller.abort(), TIMEOUT_MS);

    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-goog-api-key": apiKey
        },
        body: JSON.stringify({
          systemInstruction: {
            parts: [{
              text: "És o AGROIA, assistente da AGROINOVA ANGOLA. Ajuda com agricultura, pecuária, pesca, floresta, clima, solos, investigação, tecnologias e dados agropecuários."
            }]
          },
          contents: [{
            role: "user",
            parts: [{ text: prompt }]
          }],
          generationConfig: {
            temperature: 0.2,
            maxOutputTokens: 600
          }
        }),
        signal: controller.signal,
        cache: "no-store"
      }
    );

    if (!response.ok) {
      const detalhe = await response.text();
      console.error("AGROIA Gemini:", response.status, detalhe.slice(0, 500));

      if (response.status === 429) {
        return NextResponse.json(
          { sucesso: false, erro: "O AGROIA atingiu temporariamente o limite de pedidos gratuitos. Tenta novamente mais tarde." },
          { status: 429 }
        );
      }

      if (response.status === 401 || response.status === 403) {
        return NextResponse.json(
          { sucesso: false, erro: "Não foi possível autenticar o serviço de inteligência artificial. Verifica a configuração da API." },
          { status: 502 }
        );
      }

      return NextResponse.json(
        { sucesso: false, erro: "O serviço de inteligência artificial não conseguiu responder. Tenta novamente." },
        { status: 502 }
      );
    }

    const resultado = await response.json();

    const resposta = removerRepeticoes(
      textoSeguro(
        resultado?.candidates?.[0]?.content?.parts
          ?.map((parte: { text?: string }) => parte.text || "")
          .join("\n")
      )
    );

    if (!resposta) {
      console.error("AGROIA: resposta vazia ou bloqueada.", resultado?.promptFeedback);

      return NextResponse.json(
        { sucesso: false, erro: "A IA não devolveu uma resposta. Reformula a pergunta e tenta novamente." },
        { status: 502 }
      );
    }

    console.log("AGROIA: resposta Gemini recebida.");

    return NextResponse.json(
      { sucesso: true, resposta },
      { headers: { "Cache-Control": "no-store" } }
    );

  } catch (error: unknown) {
    console.error("ERRO AGROIA:", error);

    const expirou =
      error instanceof Error &&
      (error.name === "AbortError" || error.name === "TimeoutError");

    return NextResponse.json(
      {
        sucesso: false,
        erro: expirou
          ? "A análise demorou demasiado. Tenta novamente."
          : "Não foi possível contactar o serviço de inteligência artificial. Tenta novamente."
      },
      { status: expirou ? 504 : 503 }
    );

  } finally {
    if (timeout) clearTimeout(timeout);
  }
}